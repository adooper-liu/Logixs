{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion", "sheets", "pilotMappings"],
  "properties": {
    "policyVersion": { "type": "string", "minLength": 1 },
    "mappingVersion": { "type": "string", "minLength": 1 },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "headerRow", "disposition"],
        "properties": {
          "name": { "type": "string" },
          "headerRow": { "type": "integer", "minimum": 1 },
          "headerFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "disposition": {
            "enum": ["records", "evidence_only", "gap", "unsupported"]
          }
        }
      }
    },
    "pilotMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordType",
          "sheet",
          "identity",
          "payload",
          "fieldPolicy"
        ],
        "properties": {
          "recordType": { "type": "string" },
          "sheet": { "type": "string" },
          "identity": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "payload": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "rowFilter": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "fieldPolicy": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["directSource", "constructionOverrideAllowed"],
              "properties": {
                "directSource": { "type": "boolean" },
                "constructionOverrideAllowed": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "CHECK_UNIQUE_BUSINESS_KEY",
          "CHECK_REFERENCE_EXISTS",
          "CHECK_MBL_MATCH",
          "CHECK_HBL_SCOPE",
          "CHECK_DATE_ORDER",
          "CHECK_QUANTITY_RECONCILIATION",
          "CHECK_WEIGHT_RECONCILIATION",
          "CHECK_VOLUME_RECONCILIATION",
          "CHECK_DERIVATION_RECOMPUTED"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defaultStatus", "reason"],
        "properties": {
          "defaultStatus": { "const": "not_applicable" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
