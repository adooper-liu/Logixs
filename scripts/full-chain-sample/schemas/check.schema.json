{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "status"],
  "properties": {
    "code": { "type": "string" },
    "status": { "enum": ["pass", "fail", "not_applicable"] },
    "recordRefs": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string" }
  }
}
