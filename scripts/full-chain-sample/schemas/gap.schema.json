{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "status", "reason"],
  "properties": {
    "code": { "type": "string" },
    "status": { "enum": ["open", "blocking", "informational"] },
    "recordRef": { "type": "string" },
    "reason": { "type": "string" }
  }
}
