# Logix 本地开发环境变量示例。复制为 .env 使用（.env 已被 .gitignore 忽略）。
# 数据库（docker-compose 阶段 P4 提供的本地 PostgreSQL；端口 5433 避开旧系统 5432）
DATABASE_URL="postgresql://logix:logix@localhost:5433/logix?schema=public"

# 导入原文件对象存储（本地对应 docker-compose MinIO；生产必须使用独立凭据）
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ACCESS_KEY="logix"
OBJECT_STORAGE_SECRET_KEY="logix-dev-secret"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
OBJECT_STORAGE_AUTO_CREATE="true"
OBJECT_STORAGE_TIMEOUT_MS="10000"
IMPORT_SOURCE_BUCKET="logix-import-sources"
