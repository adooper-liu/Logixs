# Logix 本地开发环境变量示例。复制为 .env 使用（.env 已被 .gitignore 忽略）。
# 数据库（docker-compose 阶段 P4 提供的本地 PostgreSQL；端口 5433 避开旧系统 5432）
DATABASE_URL="postgresql://logix:logix@localhost:5433/logix?schema=public"

# 用户认证：仅 NODE_ENV=development/test 可用开发请求头；其他环境强制 OIDC
AUTH_MODE="development"
# AUTH_MODE="oidc"
# OIDC_ISSUER_URL="http://localhost:8080/realms/logix"
# OIDC_AUDIENCE="logix-api"
# OIDC_JWKS_URL="http://localhost:8080/realms/logix/protocol/openid-connect/certs"
# OIDC_TENANT_CLAIM="tenant_id"

# Web 认证（Vite 只读取 apps/web/ 下的 .env.*.local 或进程环境，不读取本文件）。
# 没有内置默认身份：本机开发须在 apps/web/.env.development.local 显式写入 development 段，
# 未配置时 Web 拒绝启动。生产构建只接受 oidc，缺任一必填项即拒绝启动；
# 任何名称含 SECRET 的 VITE_ 变量会在构建/启动前被拒绝。
# VITE_AUTH_MODE="development"
# VITE_DEV_TENANT_ID="demo-real-sample-20260921"
# VITE_DEV_OPERATOR_ID="dev-operator"
# VITE_DEV_ROLES="operations_dispatcher"
# VITE_AUTH_MODE="oidc"
# VITE_OIDC_AUTHORITY="https://idp.example.com/realms/logix"
# VITE_OIDC_CLIENT_ID="logix-web"
# VITE_OIDC_SCOPE="openid profile"
# VITE_OIDC_REDIRECT_URI="https://app.example.com/auth/callback"
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI="https://app.example.com/auth/logout-callback"
# VITE_OIDC_SILENT_REDIRECT_URI="https://app.example.com/auth/silent-callback"

# 导入原文件对象存储（本地对应 docker-compose MinIO；生产必须使用独立凭据）
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ACCESS_KEY="logix"
OBJECT_STORAGE_SECRET_KEY="logix-dev-secret"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
OBJECT_STORAGE_AUTO_CREATE="true"
OBJECT_STORAGE_TIMEOUT_MS="10000"
IMPORT_SOURCE_BUCKET="logix-import-sources"
