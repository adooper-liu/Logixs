// Logix 数据库 schema（ADR-003：PostgreSQL + Prisma，唯一迁移入口 database/migrations/）。
// 命名：DB 列 snake_case（@map），Prisma/代码属性 camelCase；DTO 与实体显式映射，禁止偶然同名。
// 单一权威源：packages/contracts/schemas/v1/*.schema.json（字段/枚举口径）。
// 状态：本文件是「数据库字段优先」的第一步——只落已定稿字段，物理形态待评审项显式注明。

generator client {
  provider = "prisma-client-js"
  // 单一输出，避免 pnpm 在根包和 @logix/api 各放一份 @prisma/client 时，
  // generate 更新其中一份、tsc 读另一份空桩（CI typecheck 会报 PrismaClient 不存在）。
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Product/SKU 稳定身份（master-data 拥有）：交易行和合规档案只保存逻辑引用。
model ProductSku {
  id                  String                     @id @default(uuid()) @map("id") @db.Uuid
  tenantId            String                     @map("tenant_id")
  productNumber       String                     @map("product_number")
  version             Int                        @default(1) @map("version")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  registrations       ProductSkuRegistration[]
  complianceProfiles  ProductComplianceProfile[]
  productCertificates ProductCertificate[]

  @@unique([tenantId, productNumber], map: "product_sku_tenant_number_key")
  @@unique([id, tenantId], map: "product_sku_id_tenant_key")
  @@index([tenantId, createdAt, id], map: "product_sku_tenant_created_idx")
  @@map("product_sku")
}

// SKU 注册幂等结果：同键重放返回原身份，同键异载荷明确冲突。
model ProductSkuRegistration {
  id             String     @id @default(uuid()) @map("id") @db.Uuid
  tenantId       String     @map("tenant_id")
  idempotencyKey String     @map("idempotency_key")
  payloadHash    String     @map("payload_hash")
  productSkuId   String     @map("product_sku_id") @db.Uuid
  productSku     ProductSku @relation(fields: [productSkuId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, idempotencyKey], map: "product_sku_registration_tenant_key")
  @@index([productSkuId], map: "product_sku_registration_product_idx")
  @@map("product_sku_registration")
}

// SKU 结构化合规档案版本头（master-data 拥有）：每个 SKU 仅一个 active 版本。
model ProductComplianceProfile {
  id                     String                                @id @default(uuid()) @map("id") @db.Uuid
  tenantId               String                                @map("tenant_id")
  productSkuId           String                                @map("product_sku_id") @db.Uuid
  productSku             ProductSku                            @relation(fields: [productSkuId, tenantId], references: [id, tenantId], onDelete: Restrict)
  version                Int                                   @map("version")
  state                  String                                @map("state")
  supersedesProfileId    String?                               @map("supersedes_profile_id") @db.Uuid
  supersedesProfile      ProductComplianceProfile?             @relation("ProductComplianceProfileSupersession", fields: [supersedesProfileId, tenantId, productSkuId], references: [id, tenantId, productSkuId], onDelete: Restrict)
  supersededBy           ProductComplianceProfile?             @relation("ProductComplianceProfileSupersession")
  ingestionChannel       String                                @map("ingestion_channel")
  sourceSystem           String                                @map("source_system")
  evidenceRefs           Json                                  @map("evidence_refs")
  verificationState      String                                @map("verification_state")
  actorId                String                                @map("actor_id")
  reasonCode             String                                @map("reason_code")
  idempotencyKey         String                                @map("idempotency_key")
  payloadHash            String                                @map("payload_hash")
  createdAt              DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  supersededAt           DateTime?                             @map("superseded_at") @db.Timestamptz
  battery                ProductBatteryProfile?
  refrigerant            ProductRefrigerantProfile?
  dangerousGoods         ProductDangerousGoodsProfile?
  inspectionRequirements ProductInspectionRequirement[]
  certificateLinks       ProductComplianceProfileCertificate[]

  @@unique([id, tenantId], map: "product_compliance_profile_id_tenant_key")
  @@unique([id, tenantId, productSkuId], map: "product_compliance_profile_id_tenant_sku_key")
  @@unique([tenantId, idempotencyKey], map: "product_compliance_profile_tenant_idempotency_key")
  @@unique([tenantId, productSkuId, version], map: "product_compliance_profile_sku_version_key")
  @@unique([supersedesProfileId, tenantId, productSkuId], map: "product_compliance_profile_supersedes_tenant_sku_key")
  @@index([tenantId, productSkuId, state], map: "product_compliance_profile_active_idx")
  @@map("product_compliance_profile")
}

model ProductBatteryProfile {
  id                  String                   @id @default(uuid()) @map("id") @db.Uuid
  tenantId            String                   @map("tenant_id")
  profileId           String                   @map("profile_id") @db.Uuid
  profile             ProductComplianceProfile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  presenceState       String                   @map("presence_state")
  chemistryCode       String?                  @map("chemistry_code")
  modelNumber         String?                  @map("model_number")
  cellCount           Int?                     @map("cell_count")
  batteryCount        Int?                     @map("battery_count")
  wattHours           Decimal?                 @map("watt_hours") @db.Decimal(15, 3)
  lithiumContentGrams Decimal?                 @map("lithium_content_grams") @db.Decimal(15, 3)
  removable           Boolean?                 @map("removable")
  packingMode         String?                  @map("packing_mode")

  @@unique([profileId, tenantId], map: "product_battery_profile_profile_tenant_key")
  @@index([tenantId, profileId], map: "product_battery_profile_tenant_profile_idx")
  @@map("product_battery_profile")
}

model ProductRefrigerantProfile {
  id                     String                   @id @default(uuid()) @map("id") @db.Uuid
  tenantId               String                   @map("tenant_id")
  profileId              String                   @map("profile_id") @db.Uuid
  profile                ProductComplianceProfile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  presenceState          String                   @map("presence_state")
  refrigerantCode        String?                  @map("refrigerant_code")
  chargeQuantity         Decimal?                 @map("charge_quantity") @db.Decimal(15, 3)
  chargeUnit             String?                  @map("charge_unit")
  globalWarmingPotential Decimal?                 @map("global_warming_potential") @db.Decimal(15, 3)
  hermeticallySealed     Boolean?                 @map("hermetically_sealed")

  @@unique([profileId, tenantId], map: "product_refrigerant_profile_profile_tenant_key")
  @@index([tenantId, profileId], map: "product_refrigerant_profile_tenant_profile_idx")
  @@map("product_refrigerant_profile")
}

model ProductDangerousGoodsProfile {
  id                  String                   @id @default(uuid()) @map("id") @db.Uuid
  tenantId            String                   @map("tenant_id")
  profileId           String                   @map("profile_id") @db.Uuid
  profile             ProductComplianceProfile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  classificationState String                   @map("classification_state")
  unNumber            String?                  @map("un_number")
  properShippingName  String?                  @map("proper_shipping_name")
  hazardClass         String?                  @map("hazard_class")
  division            String?                  @map("division")
  packingGroup        String?                  @map("packing_group")
  marinePollutant     Boolean?                 @map("marine_pollutant")
  flashPointCelsius   Decimal?                 @map("flash_point_celsius") @db.Decimal(9, 3)

  @@unique([profileId, tenantId], map: "product_dg_profile_profile_tenant_key")
  @@index([tenantId, profileId], map: "product_dg_profile_tenant_profile_idx")
  @@map("product_dangerous_goods_profile")
}

model ProductInspectionRequirement {
  id                      String                   @id @default(uuid()) @map("id") @db.Uuid
  tenantId                String                   @map("tenant_id")
  profileId               String                   @map("profile_id") @db.Uuid
  profile                 ProductComplianceProfile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requirementType         String                   @map("requirement_type")
  requirementState        String                   @map("requirement_state")
  jurisdictionCountryCode String?                  @map("jurisdiction_country_code")
  notes                   String?                  @map("notes")

  @@index([tenantId, profileId], map: "product_inspection_requirement_profile_idx")
  @@map("product_inspection_requirement")
}

// 证书稳定身份与版本归 master-data；文件本体由 document-records 拥有。
model ProductCertificate {
  id              String                      @id @default(uuid()) @map("id") @db.Uuid
  tenantId        String                      @map("tenant_id")
  productSkuId    String                      @map("product_sku_id") @db.Uuid
  productSku      ProductSku                  @relation(fields: [productSkuId, tenantId], references: [id, tenantId], onDelete: Restrict)
  certificateKey  String                      @map("certificate_key")
  certificateType String                      @map("certificate_type")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  versions        ProductCertificateVersion[]

  @@unique([id, tenantId], map: "product_certificate_id_tenant_key")
  @@unique([id, tenantId, productSkuId], map: "product_certificate_id_tenant_sku_key")
  @@unique([tenantId, productSkuId, certificateKey], map: "product_certificate_sku_key")
  @@index([tenantId, productSkuId], map: "product_certificate_sku_idx")
  @@map("product_certificate")
}

model ProductCertificateVersion {
  id                     String                                @id @default(uuid()) @map("id") @db.Uuid
  tenantId               String                                @map("tenant_id")
  productCertificateId   String                                @map("product_certificate_id") @db.Uuid
  productSkuId           String                                @map("product_sku_id") @db.Uuid
  productCertificate     ProductCertificate                    @relation(fields: [productCertificateId, tenantId, productSkuId], references: [id, tenantId, productSkuId], onDelete: Restrict)
  version                Int                                   @map("version")
  supersedesVersionId    String?                               @map("supersedes_version_id") @db.Uuid
  supersedesVersion      ProductCertificateVersion?            @relation("ProductCertificateVersionSupersession", fields: [supersedesVersionId, tenantId, productCertificateId], references: [id, tenantId, productCertificateId], onDelete: Restrict)
  supersededBy           ProductCertificateVersion?            @relation("ProductCertificateVersionSupersession")
  certificateNumber      String                                @map("certificate_number")
  issuerName             String                                @map("issuer_name")
  coverageScope          String                                @map("coverage_scope")
  validFrom              DateTime                              @map("valid_from") @db.Date
  validUntil             DateTime?                             @map("valid_until") @db.Date
  documentRecordId       String                                @map("document_record_id") @db.Uuid
  verificationState      String                                @map("verification_state")
  payloadHash            String                                @map("payload_hash")
  createdAt              DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  countryCoverage        ProductCertificateCountryCoverage[]
  complianceProfileLinks ProductComplianceProfileCertificate[]

  @@unique([id, tenantId], map: "product_certificate_version_id_tenant_key")
  @@unique([id, tenantId, productSkuId], map: "product_certificate_version_id_tenant_sku_key")
  @@unique([id, tenantId, productCertificateId], map: "product_certificate_version_id_tenant_certificate_key")
  @@unique([tenantId, productCertificateId, version], map: "product_certificate_version_number_key")
  @@unique([supersedesVersionId, tenantId, productCertificateId], map: "product_certificate_version_supersedes_tenant_certificate_key")
  @@index([tenantId, productCertificateId, version], map: "product_certificate_version_latest_idx")
  @@map("product_certificate_version")
}

model ProductCertificateCountryCoverage {
  id                   String                    @id @default(uuid()) @map("id") @db.Uuid
  tenantId             String                    @map("tenant_id")
  certificateVersionId String                    @map("certificate_version_id") @db.Uuid
  certificateVersion   ProductCertificateVersion @relation(fields: [certificateVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  countryCode          String                    @map("country_code")

  @@unique([certificateVersionId, countryCode], map: "product_certificate_country_key")
  @@index([tenantId, certificateVersionId], map: "product_certificate_country_tenant_idx")
  @@map("product_certificate_country_coverage")
}

model ProductComplianceProfileCertificate {
  id                   String                    @id @default(uuid()) @map("id") @db.Uuid
  tenantId             String                    @map("tenant_id")
  productSkuId         String                    @map("product_sku_id") @db.Uuid
  profileId            String                    @map("profile_id") @db.Uuid
  profile              ProductComplianceProfile  @relation(fields: [profileId, tenantId, productSkuId], references: [id, tenantId, productSkuId], onDelete: Restrict)
  certificateVersionId String                    @map("certificate_version_id") @db.Uuid
  certificateVersion   ProductCertificateVersion @relation(fields: [certificateVersionId, tenantId, productSkuId], references: [id, tenantId, productSkuId], onDelete: Restrict)

  @@unique([profileId, certificateVersionId], map: "product_compliance_profile_certificate_key")
  @@index([tenantId, certificateVersionId], map: "product_compliance_certificate_version_idx")
  @@map("product_compliance_profile_certificate")
}

// 合规规则稳定身份与追加版本（compliance-management 拥有）。规则只有经过证据核验和授权发布后才参与评审。
model ComplianceRule {
  id        String                  @id @default(uuid()) @map("id") @db.Uuid
  tenantId  String                  @map("tenant_id")
  ruleCode  String                  @map("rule_code")
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz
  versions  ComplianceRuleVersion[]

  @@unique([id, tenantId], map: "compliance_rule_id_tenant_key")
  @@unique([tenantId, ruleCode], map: "compliance_rule_tenant_code_key")
  @@map("compliance_rule")
}

model ComplianceRuleVersion {
  id                        String                               @id @default(uuid()) @map("id") @db.Uuid
  tenantId                  String                               @map("tenant_id")
  ruleId                    String                               @map("rule_id") @db.Uuid
  rule                      ComplianceRule                       @relation(fields: [ruleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  version                   Int                                  @map("version")
  state                     String                               @map("state")
  requirementLayer          String                               @map("requirement_layer")
  jurisdictionCountryCode   String                               @map("jurisdiction_country_code") @db.Char(2)
  effectiveFrom             DateTime                             @map("effective_from") @db.Date
  effectiveTo               DateTime?                            @map("effective_to") @db.Date
  appliesToAllSkus          Boolean                              @map("applies_to_all_skus")
  batteryRequirement        String                               @map("battery_requirement")
  refrigerantRequirement    String                               @map("refrigerant_requirement")
  dangerousGoodsRequirement String                               @map("dangerous_goods_requirement")
  requiredCertificateTypes  Json                                 @map("required_certificate_types")
  blockingNodeCodes         Json                                 @map("blocking_node_codes")
  severity                  String                               @map("severity")
  officialSourceUrl         String                               @map("official_source_url")
  legalCitation             String                               @map("legal_citation")
  owner                     String                               @map("owner")
  approvedBy                String                               @map("approved_by")
  approvedAt                DateTime                             @default(now()) @map("approved_at") @db.Timestamptz
  supersedesRuleVersionId   String?                              @map("supersedes_rule_version_id") @db.Uuid
  supersedesRuleVersion     ComplianceRuleVersion?               @relation("ComplianceRuleVersionSupersession", fields: [supersedesRuleVersionId, tenantId, ruleId], references: [id, tenantId, ruleId], onDelete: Restrict)
  supersededBy              ComplianceRuleVersion?               @relation("ComplianceRuleVersionSupersession")
  evidenceRefs              Json                                 @map("evidence_refs")
  reasonCode                String                               @map("reason_code")
  idempotencyKey            String                               @map("idempotency_key")
  payloadHash               String                               @map("payload_hash")
  createdAt                 DateTime                             @default(now()) @map("created_at") @db.Timestamptz
  retiredAt                 DateTime?                            @map("retired_at") @db.Timestamptz
  skuScopes                 ComplianceRuleVersionSkuScope[]
  assessmentRules           CargoReadyComplianceAssessmentRule[]

  @@unique([id, tenantId], map: "compliance_rule_version_id_tenant_key")
  @@unique([id, tenantId, ruleId], map: "compliance_rule_version_id_scope_key")
  @@unique([tenantId, ruleId, version], map: "compliance_rule_version_number_key")
  @@unique([tenantId, idempotencyKey], map: "compliance_rule_version_idempotency_key")
  @@unique([supersedesRuleVersionId, tenantId, ruleId], map: "compliance_rule_version_supersedes_key")
  @@index([tenantId, jurisdictionCountryCode, state, effectiveFrom], map: "compliance_rule_version_applicability_idx")
  @@map("compliance_rule_version")
}

model ComplianceRuleVersionSkuScope {
  id            String                @id @default(uuid()) @map("id") @db.Uuid
  tenantId      String                @map("tenant_id")
  ruleVersionId String                @map("rule_version_id") @db.Uuid
  ruleVersion   ComplianceRuleVersion @relation(fields: [ruleVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  productSkuId  String                @map("product_sku_id") @db.Uuid

  @@unique([ruleVersionId, productSkuId], map: "compliance_rule_version_sku_key")
  @@index([tenantId, productSkuId], map: "compliance_rule_sku_tenant_idx")
  @@map("compliance_rule_version_sku_scope")
}

// cargo_ready 合规评审（compliance-management 拥有）：锁定装载与 SKU 档案快照。
model CargoReadyComplianceAssessment {
  id                      String                               @id @default(uuid()) @map("id") @db.Uuid
  tenantId                String                               @map("tenant_id")
  containerRecordId       String                               @map("container_record_id")
  version                 Int                                  @map("version")
  state                   String                               @map("state")
  jurisdictionCountryCode String                               @map("jurisdiction_country_code") @db.Char(2)
  assessmentDate          DateTime                             @map("assessment_date") @db.Date
  allocationSetId         String?                              @map("allocation_set_id") @db.Uuid
  allocationSetVersion    Int?                                 @map("allocation_set_version")
  supersedesAssessmentId  String?                              @map("supersedes_assessment_id") @db.Uuid
  supersedesAssessment    CargoReadyComplianceAssessment?      @relation("CargoReadyAssessmentSupersession", fields: [supersedesAssessmentId, tenantId, containerRecordId], references: [id, tenantId, containerRecordId], onDelete: Restrict)
  supersededBy            CargoReadyComplianceAssessment?      @relation("CargoReadyAssessmentSupersession")
  evidenceRefs            Json                                 @map("evidence_refs")
  actorId                 String                               @map("actor_id")
  reasonCode              String                               @map("reason_code")
  idempotencyKey          String                               @map("idempotency_key")
  payloadHash             String                               @map("payload_hash")
  createdAt               DateTime                             @default(now()) @map("created_at") @db.Timestamptz
  supersededAt            DateTime?                            @map("superseded_at") @db.Timestamptz
  items                   CargoReadyComplianceAssessmentItem[]
  ruleSnapshots           CargoReadyComplianceAssessmentRule[]
  findings                CargoReadyComplianceFinding[]
  decisions               CargoReadyComplianceDecision[]

  @@unique([id, tenantId], map: "cargo_ready_assessment_id_tenant_key")
  @@unique([id, tenantId, containerRecordId], map: "cargo_ready_assessment_id_scope_key")
  @@unique([tenantId, idempotencyKey], map: "cargo_ready_assessment_tenant_idempotency_key")
  @@unique([tenantId, containerRecordId, version], map: "cargo_ready_assessment_container_version_key")
  @@unique([supersedesAssessmentId, tenantId, containerRecordId], map: "cargo_ready_assessment_supersedes_scope_key")
  @@index([tenantId, containerRecordId, state], map: "cargo_ready_assessment_current_idx")
  @@map("cargo_ready_compliance_assessment")
}

model CargoReadyComplianceAssessmentItem {
  id                       String                         @id @default(uuid()) @map("id") @db.Uuid
  tenantId                 String                         @map("tenant_id")
  assessmentId             String                         @map("assessment_id") @db.Uuid
  assessment               CargoReadyComplianceAssessment @relation(fields: [assessmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  replenishmentOrderLineId String                         @map("replenishment_order_line_id")
  productSkuId             String                         @map("product_sku_id") @db.Uuid
  productNumber            String                         @map("product_number")
  complianceProfileId      String?                        @map("compliance_profile_id") @db.Uuid
  complianceProfileVersion Int?                           @map("compliance_profile_version")

  @@unique([assessmentId, replenishmentOrderLineId], map: "cargo_ready_assessment_item_line_key")
  @@unique([id, assessmentId], map: "cargo_ready_assessment_item_id_assessment_key")
  @@index([tenantId, productSkuId], map: "cargo_ready_assessment_item_sku_idx")
  @@map("cargo_ready_compliance_assessment_item")
}

model CargoReadyComplianceFinding {
  id            String                         @id @default(uuid()) @map("id") @db.Uuid
  tenantId      String                         @map("tenant_id")
  assessmentId  String                         @map("assessment_id") @db.Uuid
  assessment    CargoReadyComplianceAssessment @relation(fields: [assessmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  code          String                         @map("code")
  productSkuId  String?                        @map("product_sku_id") @db.Uuid
  ruleVersionId String?                        @map("rule_version_id") @db.Uuid
  detail        String                         @map("detail")
  state         String                         @default("open") @map("state")
  createdAt     DateTime                       @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, assessmentId, state], map: "cargo_ready_finding_assessment_idx")
  @@map("cargo_ready_compliance_finding")
}

model CargoReadyComplianceAssessmentRule {
  id            String                         @id @default(uuid()) @map("id") @db.Uuid
  tenantId      String                         @map("tenant_id")
  assessmentId  String                         @map("assessment_id") @db.Uuid
  assessment    CargoReadyComplianceAssessment @relation(fields: [assessmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  ruleVersionId String                         @map("rule_version_id") @db.Uuid
  ruleVersion   ComplianceRuleVersion          @relation(fields: [ruleVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  productSkuId  String                         @map("product_sku_id") @db.Uuid

  @@unique([assessmentId, ruleVersionId, productSkuId], map: "cargo_ready_assessment_rule_sku_key")
  @@index([tenantId, ruleVersionId], map: "cargo_ready_assessment_rule_tenant_idx")
  @@map("cargo_ready_compliance_assessment_rule")
}

model CargoReadyComplianceDecision {
  id                   String                         @id @default(uuid()) @map("id") @db.Uuid
  tenantId             String                         @map("tenant_id")
  assessmentId         String                         @map("assessment_id") @db.Uuid
  assessment           CargoReadyComplianceAssessment @relation(fields: [assessmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  version              Int                            @map("version")
  decisionCode         String                         @map("decision_code")
  conditionRefs        Json                           @map("condition_refs")
  supersedesDecisionId String?                        @map("supersedes_decision_id") @db.Uuid
  supersedesDecision   CargoReadyComplianceDecision?  @relation("CargoReadyDecisionSupersession", fields: [supersedesDecisionId, tenantId, assessmentId], references: [id, tenantId, assessmentId], onDelete: Restrict)
  supersededBy         CargoReadyComplianceDecision?  @relation("CargoReadyDecisionSupersession")
  evidenceRefs         Json                           @map("evidence_refs")
  actorId              String                         @map("actor_id")
  reasonCode           String                         @map("reason_code")
  idempotencyKey       String                         @map("idempotency_key")
  payloadHash          String                         @map("payload_hash")
  decidedAt            DateTime                       @default(now()) @map("decided_at") @db.Timestamptz
  supersededAt         DateTime?                      @map("superseded_at") @db.Timestamptz

  @@unique([id, tenantId], map: "cargo_ready_decision_id_tenant_key")
  @@unique([id, tenantId, assessmentId], map: "cargo_ready_decision_id_scope_key")
  @@unique([tenantId, idempotencyKey], map: "cargo_ready_decision_tenant_idempotency_key")
  @@unique([assessmentId, version], map: "cargo_ready_decision_assessment_version_key")
  @@unique([supersedesDecisionId, tenantId, assessmentId], map: "cargo_ready_decision_supersedes_scope_key")
  @@index([tenantId, assessmentId, supersededAt], map: "cargo_ready_decision_current_idx")
  @@map("cargo_ready_compliance_decision")
}

// 货柜当前阶段：8 态，与 packages/contracts/schemas/v1/common.schema.json 的
// ContainerLifecycleState 枚举严格一致（G7 显式映射 parity 门禁校验，禁止漂移）。
enum ContainerStatus {
  not_shipped
  shipped
  in_transit
  at_port
  picked_up
  unloaded
  returned_empty
  cancelled
}

// 货柜业务事实主记录（shipment-registry 拥有）。
// 字段依据：DATA_MODEL_P2-06 §B、CONTAINER_STATUS_MODEL §⑦、ContainerLifecycleState 枚举。
model ContainerRecord {
  id                   String                        @id @default(uuid()) @map("id")
  tenantId             String                        @map("tenant_id")
  // 旧导入兼容锚；柜内货物与备货单的权威关系由 ContainerCargoAllocation 表达。
  orderNumber          String                        @map("order_number")
  replenishmentOrderId String?                       @map("replenishment_order_id")
  replenishmentOrder   ReplenishmentOrder?           @relation(fields: [replenishmentOrderId], references: [id])
  // 票级展示用主备货单号，不作键/关系（DATA_MODEL 不变量 2）。
  mainOrderNumber      String?                       @map("main_order_number")
  // 箱号迟绑定：装箱后与外部交换才产生；可空、非全局唯一（跨单复用）。
  containerNumber      String?                       @map("container_number")
  // 货柜当前阶段（历史推进由时间线事件记录，不覆盖）。
  currentStatus        ContainerStatus               @map("current_status")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")
  timeFacts            ShipmentTimeFact[]
  lifecycleDateFacts   LifecycleDateFact[]
  oceanRoutePlans      OceanRoutePlan[]
  cargoAllocationSets  ContainerCargoAllocationSet[]
  stuffingSnapshots    ContainerStuffingSnapshot[]
  // TODO(D2 物理形态)：节点 planned/actual 时间（子表 vs 双列，见 NODE_TIME_FIELDS 待评审）
  // TODO(D13 物理形态)：markers/attributes 受控字典扩展（不逐特征加列）
  // TODO(D7 物理形态)：字段/事件级来源权威与证据引用列
  // TODO(D20 物理形态)：金额 decimal + currency（超期费用，独立边界）

  @@unique([id, tenantId], map: "container_record_id_tenant_key")
  @@index([tenantId, updatedAt, id])
  @@index([replenishmentOrderId])
  @@map("container_record")
}

// 货柜海运路线版本（lifecycle-control 读取，后续由受控路线写端口维护）。
// 只有 active 版本参与过站；旧版本保留用于解释历史事实。
model OceanRoutePlan {
  id                String              @id @default(uuid()) @map("id")
  containerId       String              @map("container_id")
  container         ContainerRecord     @relation(fields: [containerId], references: [id], onDelete: Restrict)
  version           Int                 @map("version")
  status            String              @map("status")
  supersedesRouteId String?             @unique(map: "ocean_route_plan_supersedes_key") @map("supersedes_route_id")
  supersedesRoute   OceanRoutePlan?     @relation("OceanRoutePlanSupersession", fields: [supersedesRouteId], references: [id], onDelete: Restrict)
  supersededBy      OceanRoutePlan?     @relation("OceanRoutePlanSupersession")
  activatedAt       DateTime            @map("activated_at") @db.Timestamptz
  supersededAt      DateTime?           @map("superseded_at") @db.Timestamptz
  ingestionChannel  String              @map("ingestion_channel")
  sourceSystem      String              @map("source_system")
  evidenceRefs      Json                @map("evidence_refs")
  actorId           String?             @map("actor_id")
  reasonCode        String?             @map("reason_code")
  idempotencyKey    String              @map("idempotency_key")
  payloadHash       String              @map("payload_hash")
  traceId           String              @map("trace_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  segments          OceanRouteSegment[]

  @@unique([containerId, version], map: "ocean_route_plan_container_version_key")
  @@unique([containerId, idempotencyKey], map: "ocean_route_plan_idempotency_key")
  @@index([containerId, status], map: "ocean_route_plan_container_status_idx")
  @@map("ocean_route_plan")
}

// 路线内有序航段。日期事实的 segmentId 必须指向当前 active 路线中的一段。
model OceanRouteSegment {
  id                      String         @id @default(uuid()) @map("id")
  routePlanId             String         @map("route_plan_id")
  routePlan               OceanRoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Restrict)
  sequence                Int            @map("sequence")
  transportMode           String         @map("transport_mode")
  originUnlocode          String         @map("origin_unlocode")
  originTimezone          String         @map("origin_timezone")
  destinationLocationType String         @map("destination_location_type")
  destinationUnlocode     String         @map("destination_unlocode")
  destinationLocationId   String?        @map("destination_location_id")
  destinationPortCallId   String?        @map("destination_port_call_id")
  destinationTimezone     String         @map("destination_timezone")
  isFinal                 Boolean        @default(false) @map("is_final")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@unique([routePlanId, sequence], map: "ocean_route_segment_sequence_key")
  @@index([routePlanId, isFinal], map: "ocean_route_segment_final_idx")
  @@map("ocean_route_segment")
}

// 导入时间事实（shipment-registry 拥有）：actual/estimated 分槽，保留来源原值和 UTC 标准值。
// 这里只保存可追溯领域事实；生命周期事件晋升仍由 lifecycle-control 的证据与状态机守卫负责。
model ShipmentTimeFact {
  id                    String          @id @default(uuid()) @map("id")
  tenantId              String          @map("tenant_id")
  containerRecordId     String          @map("container_record_id")
  containerRecord       ContainerRecord @relation(fields: [containerRecordId], references: [id])
  factCode              String          @map("fact_code")
  timeKind              String          @map("time_kind")
  captureSource         String          @map("capture_source")
  eventCode             String?         @map("event_code")
  rawValue              String          @map("raw_value")
  occurredAtUtc         DateTime        @map("occurred_at_utc") @db.Timestamptz
  sourceUtcOffset       String          @map("source_utc_offset")
  sourceSystem          String          @map("source_system")
  authoritySystem       String?         @map("authority_system")
  sourceStatus          String?         @map("source_status")
  evidenceRef           String?         @map("evidence_ref")
  derivationRuleVersion String?         @map("derivation_rule_version")
  sourceBatchId         String          @map("source_batch_id")
  sourceRowId           String          @map("source_row_id")
  isCurrent             Boolean         @default(true) @map("is_current")
  supersededByBatchId   String?         @map("superseded_by_batch_id")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([sourceBatchId, sourceRowId, factCode], map: "shipment_time_fact_source_key")
  @@index([tenantId, containerRecordId], map: "shipment_time_fact_tenant_container_idx")
  @@index([containerRecordId, factCode, isCurrent], map: "shipment_time_fact_current_idx")
  @@map("shipment_time_fact")
}

// 全生命周期日期事实（lifecycle-control 拥有）：三种入口共用，追加版本而不覆盖历史。
model LifecycleDateFact {
  id                    String              @id @default(uuid()) @map("id")
  tenantId              String              @map("tenant_id")
  containerId           String              @map("container_id")
  container             ContainerRecord     @relation(fields: [containerId], references: [id])
  nodeCode              String              @map("node_code")
  eventCode             String              @map("event_code")
  timeKind              String              @map("time_kind")
  occurredAt            DateTime            @map("occurred_at") @db.Timestamptz
  rawValue              String              @map("raw_value")
  sourceUtcOffset       String              @map("source_utc_offset")
  ingestionChannel      String              @map("ingestion_channel")
  captureSource         String              @map("capture_source")
  sourceSystem          String              @map("source_system")
  authoritySystem       String              @map("authority_system")
  provider              String?             @map("provider")
  interfaceCode         String?             @map("interface_code")
  sourceEventId         String?             @map("source_event_id")
  mappingVersion        String?             @map("mapping_version")
  verificationState     String              @map("verification_state")
  confidenceState       String              @map("confidence_state")
  validity              String              @map("validity")
  authorityPolicyRef    String?             @map("authority_policy_ref")
  locationType          String?             @map("location_type")
  unlocode              String?             @map("unlocode")
  locationId            String?             @map("location_id")
  segmentId             String?             @map("segment_id")
  portCallId            String?             @map("port_call_id")
  locationTimezone      String?             @map("location_timezone")
  evidenceRefs          Json                @map("evidence_refs")
  actorId               String?             @map("actor_id")
  reasonCode            String?             @map("reason_code")
  idempotencyKey        String              @map("idempotency_key")
  payloadHash           String              @map("payload_hash")
  supersedesFactId      String?             @map("supersedes_fact_id")
  supersedesFact        LifecycleDateFact?  @relation("LifecycleDateFactCorrections", fields: [supersedesFactId], references: [id])
  corrections           LifecycleDateFact[] @relation("LifecycleDateFactCorrections")
  isCurrent             Boolean             @default(true) @map("is_current")
  applicationState      String              @map("application_state")
  applicationReasonCode String?             @map("application_reason_code")
  canonicalEventId      String?             @unique(map: "lifecycle_date_fact_canonical_event_key") @map("canonical_event_id")
  canonicalEvent        CanonicalEvent?     @relation("LifecycleDateFactAppliedEvent", fields: [canonicalEventId], references: [id])
  sourceCanonicalEvent  CanonicalEvent?     @relation("CanonicalEventDomainFact")
  nodeBlocks            NodeBlock[]
  projectionVersion     Int                 @map("projection_version")
  traceId               String              @map("trace_id")
  receivedAt            DateTime            @map("received_at") @db.Timestamptz
  recordedAt            DateTime            @default(now()) @map("recorded_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  applicationLeaseOwner String?             @map("application_lease_owner")
  applicationLeaseUntil DateTime?           @map("application_lease_until") @db.Timestamptz
  applicationAttempts   Int                 @default(0) @map("application_attempts")
  lastApplicationAt     DateTime?           @map("last_application_at") @db.Timestamptz

  @@unique([tenantId, idempotencyKey], map: "lifecycle_date_fact_tenant_idempotency_key")
  @@unique([containerId, projectionVersion], map: "lifecycle_date_fact_container_version_key")
  @@index([tenantId, containerId, isCurrent], map: "lifecycle_date_fact_current_idx")
  @@index([containerId, nodeCode, eventCode, timeKind, isCurrent], map: "lifecycle_date_fact_slot_idx")
  @@index([containerId, nodeCode, eventCode, timeKind, segmentId, isCurrent], map: "lifecycle_date_fact_segment_slot_idx")
  @@index([applicationState, recordedAt, id], map: "lifecycle_date_fact_application_idx")
  @@map("lifecycle_date_fact")
}

// 证据来源权威策略：版本化运行时配置；策略只决定事实资格，不直接推进生命周期。
model SourceAuthorityPolicy {
  id                        String    @id @default(uuid()) @map("id")
  policyId                  String    @map("policy_id")
  policyVersion             Int       @map("policy_version")
  effectiveFrom             DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo               DateTime? @map("effective_to") @db.Timestamptz
  tenantScope               String?   @map("tenant_scope")
  factType                  String?   @map("fact_type")
  eventCode                 String?   @map("event_code")
  fieldCode                 String?   @map("field_code")
  subjectType               String    @map("subject_type")
  jurisdiction              String?   @map("jurisdiction")
  direction                 String?   @map("direction")
  locationRole              String?   @map("location_role")
  transportMode             String?   @map("transport_mode")
  timeKind                  String?   @map("time_kind")
  allowedAuthoritySystems   Json      @map("allowed_authority_systems")
  allowedSourceTypes        Json      @map("allowed_source_types")
  minimumAuthorityLevel     String    @map("minimum_authority_level")
  requiredEvidenceTypes     Json      @map("required_evidence_types")
  verificationRequirements  Json      @map("verification_requirements")
  corroborationRule         String?   @map("corroboration_rule")
  conflictAction            String    @map("conflict_action")
  manualCorrectionPolicyRef String    @map("manual_correction_policy_ref")
  sealingPolicyRef          String    @map("sealing_policy_ref")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([policyId, policyVersion], map: "source_authority_policy_version_key")
  @@index([eventCode, subjectType, effectiveFrom], map: "source_authority_policy_event_idx")
  @@index([tenantScope, eventCode, timeKind], map: "source_authority_policy_scope_idx")
  @@map("source_authority_policy")
}

// 备货单身份表（shipment-registry 拥有）：租户内备货单号唯一。
model ReplenishmentOrder {
  id               String                   @id @default(uuid()) @map("id")
  tenantId         String                   @map("tenant_id")
  orderNumber      String                   @map("order_number")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  containerRecords ContainerRecord[]
  lines            ReplenishmentOrderLine[]

  @@unique([tenantId, orderNumber], map: "replenishment_order_tenant_order_key")
  @@unique([id, tenantId], map: "replenishment_order_id_tenant_key")
  @@map("replenishment_order")
}

// 产品明细（shipment-registry 拥有）：重导时保留历史版本，只切换 is_current。
model ReplenishmentOrderLine {
  id                   String                     @id @default(uuid()) @map("id")
  tenantId             String                     @map("tenant_id")
  replenishmentOrderId String                     @map("replenishment_order_id")
  replenishmentOrder   ReplenishmentOrder         @relation(fields: [replenishmentOrderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  productSkuId         String?                    @map("product_sku_id") @db.Uuid
  productNumber        String                     @map("product_number")
  shippedQuantity      Decimal                    @map("shipped_quantity") @db.Decimal(18, 3)
  quantityUnit         String                     @map("quantity_unit")
  contractNumber       String?                    @map("contract_number")
  sourceBatchId        String                     @map("source_batch_id")
  sourceRowId          String                     @map("source_row_id")
  isCurrent            Boolean                    @default(true) @map("is_current")
  supersededByBatchId  String?                    @map("superseded_by_batch_id")
  version              Int                        @default(1) @map("version")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  cargoAllocations     ContainerCargoAllocation[]

  @@unique([sourceBatchId, sourceRowId], map: "replenishment_order_line_source_key")
  @@unique([id, tenantId], map: "replenishment_order_line_id_tenant_key")
  @@index([replenishmentOrderId, isCurrent], map: "replenishment_order_line_current_idx")
  @@index([tenantId, productSkuId, isCurrent], map: "replenishment_order_line_sku_current_idx")
  @@map("replenishment_order_line")
}

// 货柜实际装载快照（shipment-registry 拥有）：每柜只有一个 active 版本，更正追加新集合。
model ContainerCargoAllocationSet {
  id                String                       @id @default(uuid()) @map("id") @db.Uuid
  tenantId          String                       @map("tenant_id")
  containerRecordId String                       @map("container_record_id")
  containerRecord   ContainerRecord              @relation(fields: [containerRecordId, tenantId], references: [id, tenantId], onDelete: Restrict)
  version           Int                          @map("version")
  state             String                       @map("state")
  supersedesSetId   String?                      @map("supersedes_set_id") @db.Uuid
  supersedesSet     ContainerCargoAllocationSet? @relation("ContainerCargoAllocationSetSupersession", fields: [supersedesSetId, tenantId], references: [id, tenantId], onDelete: Restrict)
  supersededBy      ContainerCargoAllocationSet? @relation("ContainerCargoAllocationSetSupersession")
  ingestionChannel  String                       @map("ingestion_channel")
  sourceSystem      String                       @map("source_system")
  evidenceRefs      Json                         @map("evidence_refs")
  idempotencyKey    String                       @map("idempotency_key")
  payloadHash       String                       @map("payload_hash")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  supersededAt      DateTime?                    @map("superseded_at") @db.Timestamptz
  allocations       ContainerCargoAllocation[]
  stuffingSnapshots ContainerStuffingSnapshot[]

  @@unique([id, tenantId], map: "container_cargo_set_id_tenant_key")
  @@unique([id, tenantId, containerRecordId], map: "container_cargo_set_id_scope_key")
  @@unique([tenantId, idempotencyKey], map: "container_cargo_set_tenant_idempotency_key")
  @@unique([containerRecordId, version], map: "container_cargo_set_container_version_key")
  @@unique([supersedesSetId, tenantId], map: "container_cargo_set_supersedes_tenant_key")
  @@index([tenantId, containerRecordId, state], map: "container_cargo_set_active_lookup_idx")
  @@map("container_cargo_allocation_set")
}

// 实际装箱结果快照（shipment-registry 拥有）：更正追加新版本，不覆盖已参与过站判断的历史。
model ContainerStuffingSnapshot {
  id                   String                     @id @default(uuid()) @map("id") @db.Uuid
  tenantId             String                     @map("tenant_id")
  containerRecordId    String                     @map("container_record_id")
  containerRecord      ContainerRecord            @relation(fields: [containerRecordId, tenantId], references: [id, tenantId], onDelete: Restrict)
  version              Int                        @map("version")
  state                String                     @map("state")
  supersedesSnapshotId String?                    @map("supersedes_snapshot_id") @db.Uuid
  supersedesSnapshot   ContainerStuffingSnapshot? @relation("ContainerStuffingSnapshotSupersession", fields: [supersedesSnapshotId, tenantId, containerRecordId], references: [id, tenantId, containerRecordId], onDelete: Restrict)
  supersededBy         ContainerStuffingSnapshot? @relation("ContainerStuffingSnapshotSupersession")
  allocationSetId      String                     @map("allocation_set_id") @db.Uuid
  allocationSetVersion Int                        @map("allocation_set_version")
  allocationSet        ContainerCargoAllocationSet @relation(fields: [allocationSetId, tenantId, containerRecordId], references: [id, tenantId, containerRecordId], onDelete: Restrict)
  containerNumber      String                     @map("container_number")
  sealNumber           String                     @map("seal_number")
  packageCount         Int                        @map("package_count")
  grossWeight          Decimal                    @map("gross_weight") @db.Decimal(18, 3)
  grossWeightUnit      String                     @map("gross_weight_unit")
  netWeight            Decimal?                   @map("net_weight") @db.Decimal(18, 3)
  volume               Decimal                    @map("volume") @db.Decimal(18, 3)
  volumeUnit           String                     @map("volume_unit")
  vgmWeight            Decimal?                   @map("vgm_weight") @db.Decimal(18, 3)
  vgmWeightUnit        String?                    @map("vgm_weight_unit")
  vgmMethod            String?                    @map("vgm_method")
  vgmVerifiedAt        DateTime?                  @map("vgm_verified_at") @db.Timestamptz
  ingestionChannel     String                     @map("ingestion_channel")
  sourceSystem         String                     @map("source_system")
  evidenceRefs         Json                       @map("evidence_refs")
  actorId              String                     @map("actor_id")
  reasonCode           String                     @map("reason_code")
  idempotencyKey       String                     @map("idempotency_key")
  payloadHash          String                     @map("payload_hash")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  supersededAt         DateTime?                  @map("superseded_at") @db.Timestamptz

  @@unique([id, tenantId], map: "container_stuffing_snapshot_id_tenant_key")
  @@unique([id, tenantId, containerRecordId], map: "container_stuffing_snapshot_id_scope_key")
  @@unique([tenantId, idempotencyKey], map: "container_stuffing_snapshot_tenant_idempotency_key")
  @@unique([containerRecordId, version], map: "container_stuffing_snapshot_container_version_key")
  @@unique([supersedesSnapshotId, tenantId, containerRecordId], map: "container_stuffing_snapshot_supersedes_scope_key")
  @@index([tenantId, containerRecordId, state], map: "container_stuffing_snapshot_active_lookup_idx")
  @@index([tenantId, allocationSetId], map: "container_stuffing_snapshot_allocation_idx")
  @@map("container_stuffing_snapshot")
}

// 装载明细引用本模块产品行；Product/SKU 通过产品行的逻辑 UUID 引用解析，不建跨模块外键。
model ContainerCargoAllocation {
  id                       String                      @id @default(uuid()) @map("id") @db.Uuid
  tenantId                 String                      @map("tenant_id")
  allocationSetId          String                      @map("allocation_set_id") @db.Uuid
  allocationSet            ContainerCargoAllocationSet @relation(fields: [allocationSetId, tenantId], references: [id, tenantId], onDelete: Restrict)
  replenishmentOrderLineId String                      @map("replenishment_order_line_id")
  replenishmentOrderLine   ReplenishmentOrderLine      @relation(fields: [replenishmentOrderLineId, tenantId], references: [id, tenantId], onDelete: Restrict)
  allocatedQuantity        Decimal                     @map("allocated_quantity") @db.Decimal(18, 3)
  quantityUnit             String                      @map("quantity_unit")
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  @@unique([allocationSetId, replenishmentOrderLineId], map: "container_cargo_allocation_set_line_key")
  @@index([tenantId, replenishmentOrderLineId], map: "container_cargo_allocation_line_idx")
  @@map("container_cargo_allocation")
}

// 证据主记录（document-records 拥有）：第一刀只落核验所需字段，不做对象存储。
model EvidenceRecord {
  id                String   @id @default(uuid()) @map("id")
  tenantId          String   @map("tenant_id")
  idempotencyKey    String   @map("idempotency_key")
  evidenceType      String   @map("evidence_type")
  subjectType       String   @map("subject_type")
  subjectId         String   @map("subject_id")
  authorityLevel    String   @map("authority_level")
  contentRef        String   @map("content_ref")
  contentHash       String   @map("content_hash")
  source            Json     @map("source")
  verificationState String   @map("verification_state")
  confidenceState   String   @map("confidence_state")
  validity          String   @map("validity")
  receivedAt        DateTime @map("received_at")
  recordedAt        DateTime @map("recorded_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  decisions EvidenceVerificationDecision[]

  @@unique([tenantId, idempotencyKey], map: "evidence_record_tenant_idempotency_key")
  @@index([tenantId, subjectType, subjectId])
  @@map("evidence_record")
}

// 核验裁决（document-records 拥有）：append-only，不更新、不删除。
model EvidenceVerificationDecision {
  id                   String         @id @default(uuid()) @map("id")
  evidenceId           String         @map("evidence_id")
  evidence             EvidenceRecord @relation(fields: [evidenceId], references: [id])
  verificationSequence Int            @map("verification_sequence")
  decision             String         @map("decision")
  checks               Json           @map("checks")
  policyId             String         @map("policy_id")
  policyVersion        Int            @map("policy_version")
  decidedAt            DateTime       @map("decided_at")
  actorOrServiceId     String         @map("actor_or_service_id")
  reasonCode           String         @map("reason_code")
  reason               String?        @map("reason")
  previousDecisionId   String?        @map("previous_decision_id")
  createdAt            DateTime       @default(now()) @map("created_at")

  @@unique([evidenceId, verificationSequence], map: "evidence_decision_seq_key")
  @@map("evidence_verification_decision")
}

// 导入批次（integration-import 拥有）：一次上传的全生命周期（P6 阶段 A 读链路最小集）。
// 完整批次状态机在阶段 C 对齐 IMPORT_WORKFLOW §4；阶段 A 仅 pending → parsed。
model ImportBatch {
  id                    String            @id @default(uuid()) @map("id")
  tenantId              String            @map("tenant_id")
  operatorId            String            @map("operator_id") // 开发期身份，审计
  idempotencyKey        String            @map("idempotency_key")
  fileName              String            @map("file_name")
  fileHash              String            @map("file_hash") // 文件内容指纹，幂等判定
  sourceFileStatus      String            @default("not_retained") @map("source_file_status")
  sourceObjectKey       String?           @unique(map: "import_batch_source_object_key_key") @map("source_object_key")
  sourceContentType     String?           @map("source_content_type")
  sourceSizeBytes       Int?              @map("source_size_bytes")
  sourceRetainedAt      DateTime?         @map("source_retained_at") @db.Timestamptz
  parserVersion         String            @default("legacy-v1") @map("parser_version")
  replacesBatchId       String?           @map("replaces_batch_id")
  replacesBatch         ImportBatch?      @relation("ImportBatchReplacement", fields: [replacesBatchId], references: [id], onDelete: Restrict)
  replacementBatches    ImportBatch[]     @relation("ImportBatchReplacement")
  status                String            @map("status") // parsed | confirmed | approved | executing | completed
  rowCount              Int               @map("row_count")
  columnCount           Int               @map("column_count")
  // AI 字段映射建议（阶段 B 留痕）：[{ column, fieldCode, confidence }]，阶段 C 审核指向它
  mappingSuggestions    Json              @default("[]") @map("mapping_suggestions")
  confirmedQuantityUnit String?           @map("confirmed_quantity_unit")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  rows                  ImportRow[]
  reviews               ImportReview[]
  rowResults            ImportRowResult[]

  @@unique([tenantId, idempotencyKey], map: "import_batch_tenant_idempotency_key")
  @@index([replacesBatchId], map: "import_batch_replaces_batch_id_idx")
  @@map("import_batch")
}

// 导入行（integration-import 拥有）：一行 = 一个来源产品明细；同备货单可有多行。
model ImportRow {
  id        String      @id @default(uuid()) @map("id")
  batchId   String      @map("batch_id")
  batch     ImportBatch @relation(fields: [batchId], references: [id])
  rowNo     Int         @map("row_no")
  snapshot  Json        @map("snapshot") // 解析出的该行各列值（原始快照）
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([batchId, rowNo])
  @@map("import_row")
}

// 映射审核（integration-import 拥有）：人确认/修正列→字段映射（阶段 C）。
model ImportReview {
  id         String      @id @default(uuid()) @map("id")
  batchId    String      @map("batch_id")
  batch      ImportBatch @relation(fields: [batchId], references: [id])
  column     String      @map("column")
  fieldCode  String?     @map("field_code") // 确认/修正后的字段码；null=跳过该列
  operatorId String      @map("operator_id")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("import_review")
}

// 行落账结果（integration-import 拥有）：逐行写端口结局（阶段 C）。
model ImportRowResult {
  id                String      @id @default(uuid()) @map("id")
  batchId           String      @map("batch_id")
  batch             ImportBatch @relation(fields: [batchId], references: [id])
  rowId             String      @map("row_id")
  outcome           String      @map("outcome") // success | failed | duplicate
  containerRecordId String?     @map("container_record_id")
  detail            String?     @map("detail")
  createdAt         DateTime    @default(now()) @map("created_at")

  @@map("import_row_result")
}

// 流程实例（lifecycle-control 拥有）：一个货柜的生命周期流程（1:1 货柜）。
model FlowInstance {
  id              String         @id @default(uuid()) @map("id")
  containerId     String         @unique @map("container_id")
  state           String         @map("state") // draft | active | completed | cancelled
  currentNodeCode String         @map("current_node_code") // LifecycleNodeCode
  version         Int            @default(0) @map("version")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  nodes           NodeInstance[]
  nodeBlocks      NodeBlock[]

  @@map("flow_instance")
}

// 节点实例（lifecycle-control 拥有）：流程在某个节点的状态（第一刀只 pending/active/completed）。
model NodeInstance {
  id                String                 @id @default(uuid()) @map("id")
  flowInstanceId    String                 @map("flow_instance_id")
  flow              FlowInstance           @relation(fields: [flowInstanceId], references: [id])
  nodeCode          String                 @map("node_code")
  state             String                 @map("state") // pending | active | completed
  applicability     String                 @default("required") @map("applicability") // required | optional_applicable | optional_not_applicable
  completedAt       DateTime?              @map("completed_at")
  eventApplications NodeEventApplication[]
  blocks            NodeBlock[]

  @@unique([flowInstanceId, nodeCode])
  @@map("node_instance")
}

// 节点阻断事实（lifecycle-control 拥有）：追加保存，节点 blocked 只是未解除阻断的投影。
model NodeBlock {
  id                String               @id @map("id")
  tenantId          String               @map("tenant_id")
  flowInstanceId    String               @map("flow_instance_id")
  flow              FlowInstance         @relation(fields: [flowInstanceId], references: [id], onDelete: Restrict)
  nodeInstanceId    String               @map("node_instance_id")
  node              NodeInstance         @relation(fields: [nodeInstanceId], references: [id], onDelete: Restrict)
  blockType         String               @map("block_type")
  sourceFactId      String               @map("source_fact_id")
  sourceFact        LifecycleDateFact    @relation(fields: [sourceFactId], references: [id], onDelete: Restrict)
  occurredAt        DateTime             @map("occurred_at") @db.Timestamptz
  actorId           String               @map("actor_id")
  idempotencyKey    String               @map("idempotency_key")
  traceId           String               @map("trace_id")
  projectionVersion Int                  @map("projection_version")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  resolution        NodeBlockResolution?

  @@unique([tenantId, idempotencyKey], map: "node_block_tenant_idempotency_key")
  @@index([flowInstanceId, nodeInstanceId], map: "node_block_flow_node_idx")
  @@index([nodeInstanceId, occurredAt], map: "node_block_node_occurred_idx")
  @@map("node_block")
}

// 节点阻断解除事实：一个 blockId 最多追加一次解除，禁止覆盖原阻断。
model NodeBlockResolution {
  id                String    @id @default(uuid()) @map("id")
  tenantId          String    @map("tenant_id")
  blockId           String    @unique(map: "node_block_resolution_block_key") @map("block_id")
  block             NodeBlock @relation(fields: [blockId], references: [id], onDelete: Restrict)
  resolvedAt        DateTime  @map("resolved_at") @db.Timestamptz
  reasonCode        String    @map("reason_code")
  actorId           String    @map("actor_id")
  idempotencyKey    String    @map("idempotency_key")
  traceId           String    @map("trace_id")
  projectionVersion Int       @map("projection_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, idempotencyKey], map: "node_block_resolution_tenant_idempotency_key")
  @@map("node_block_resolution")
}

// 可选节点适用性决策留痕（lifecycle-control 拥有）。
model NodeApplicabilityDecision {
  id             String   @id @default(uuid()) @map("id")
  flowInstanceId String   @map("flow_instance_id")
  nodeCode       String   @map("node_code")
  applicability  String   @map("applicability")
  evidenceRefs   Json     @map("evidence_refs")
  reasonCode     String   @map("reason_code")
  actorId        String   @map("actor_id")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("node_applicability_decision")
}

// 规范事件流水账（lifecycle-control 拥有）：不可变事件留痕，可追溯/重放/幂等。
model CanonicalEvent {
  id                 String                 @id @default(uuid()) @map("id")
  containerId        String                 @map("container_id")
  eventCode          String                 @map("event_code")
  domainFactId       String?                @unique(map: "canonical_event_domain_fact_key") @map("domain_fact_id")
  nodeCode           String?                @map("node_code")
  timeKind           String?                @map("time_kind")
  authorityPolicyRef String?                @map("authority_policy_ref")
  locationType       String?                @map("location_type")
  unlocode           String?                @map("unlocode")
  locationId         String?                @map("location_id")
  segmentId          String?                @map("segment_id")
  portCallId         String?                @map("port_call_id")
  locationTimezone   String?                @map("location_timezone")
  domainFact         LifecycleDateFact?     @relation("CanonicalEventDomainFact", fields: [domainFactId], references: [id], onDelete: Restrict)
  occurredAt         DateTime               @map("occurred_at")
  evidenceRefs       Json                   @map("evidence_refs")
  idempotencyKey     String                 @unique @map("idempotency_key")
  appliedAt          DateTime               @default(now()) @map("applied_at")
  dateFact           LifecycleDateFact?     @relation("LifecycleDateFactAppliedEvent")
  nodeApplications   NodeEventApplication[]

  @@index([containerId, occurredAt, id], map: "canonical_event_container_occurred_idx")
  @@map("canonical_event")
}

// 规范事件对单个目标节点的应用结果；同一事件可随前序满足而逐节点重放。
model NodeEventApplication {
  id                   String         @id @default(uuid()) @map("id")
  eventId              String         @map("event_id")
  event                CanonicalEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  targetNodeInstanceId String         @map("target_node_instance_id")
  targetNodeInstance   NodeInstance   @relation(fields: [targetNodeInstanceId], references: [id], onDelete: Restrict)
  state                String         @map("state") // pending_application | applied | rejected
  evaluatedAt          DateTime       @map("evaluated_at") @db.Timestamptz
  guardResults         Json           @map("guard_results")
  reasonCode           String?        @map("reason_code")
  appliedAt            DateTime?      @map("applied_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([eventId, targetNodeInstanceId], map: "node_event_application_event_target_key")
  @@index([targetNodeInstanceId, state, evaluatedAt], map: "node_event_application_target_state_idx")
  @@map("node_event_application")
}

// 跨模块通知 Outbox（本刀由 lifecycle-control 写入）。
// 契约：GC-009 OutboxRecord；物理形态参考 CUSTOMS_DATABASE §5.2。
// 领域事件插入与 pending 同行。发布器领取后写入 publishing 租约，成功则 published。
// 单体用 owner_module 区分写入方。
model OutboxMessage {
  id              String    @id @map("id")
  tenantId        String    @map("tenant_id")
  ownerModule     String    @map("owner_module")
  eventId         String    @unique @map("event_id")
  eventType       String    @map("event_type")
  eventVersion    Int       @map("event_version")
  aggregateType   String    @map("aggregate_type")
  aggregateId     String    @map("aggregate_id")
  payloadRef      String    @map("payload_ref")
  payloadHash     String    @map("payload_hash")
  causationId     String?   @map("causation_id")
  state           String    @map("state") // pending | publishing | published | retry_wait | dead_letter
  attemptCount    Int       @default(0) @map("attempt_count")
  nextAttemptAt   DateTime? @map("next_attempt_at")
  occurredAt      DateTime  @map("occurred_at")
  idempotencyKey  String    @map("idempotency_key")
  leaseOwner      String?   @map("locked_by")
  leaseLockedAt   DateTime? @map("locked_at")
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  brokerReference String?   @map("broker_reference")
  publishedAt     DateTime? @map("published_at")
  lastErrorCode   String?   @map("last_error_code")
  failureCategory String?   @map("failure_category")
  deadLetteredAt  DateTime? @map("dead_lettered_at")
  ownerQueue      String?   @map("owner_queue")
  traceId         String    @map("trace_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, ownerModule, eventType, idempotencyKey], map: "outbox_message_idempotency_key")
  @@index([state, nextAttemptAt, createdAt], map: "outbox_message_poll_idx")
  @@index([state, leaseExpiresAt], map: "outbox_message_lease_idx")
  @@index([tenantId, ownerModule, state, deadLetteredAt, id], map: "outbox_message_dead_letter_list_idx")
  @@map("outbox_message")
}

// 死信人工重放请求（lifecycle-control 拥有）：原消息不可改，重放生成新 Outbox。
model OutboxReplayRequest {
  id                    String   @id @default(uuid()) @map("id")
  tenantId              String   @map("tenant_id")
  deadLetterId          String   @map("dead_letter_id")
  replayedOutboxId      String   @map("replayed_outbox_id")
  targetConsumerVersion String   @map("target_consumer_version")
  requestedBy           String   @map("requested_by")
  reasonCode            String   @map("reason_code")
  requestedAt           DateTime @map("requested_at")
  traceId               String   @map("trace_id")
  idempotencyKey        String   @map("idempotency_key")
  requestHash           String   @map("request_hash")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([tenantId, deadLetterId, idempotencyKey], map: "outbox_replay_idempotency_key")
  @@map("outbox_replay_request")
}

// 契约：GC-009 InboxRecord。单体用 consumer_name 区分消费者，不按模块拆物理表。
// 消费申请生命周期事件；processed 与规范事件/Outbox 同事务。
model InboxMessage {
  id              String    @id @map("id")
  tenantId        String    @map("tenant_id")
  consumerName    String    @map("consumer_name")
  messageId       String    @map("message_id")
  payloadHash     String    @map("payload_hash")
  payloadJson     Json?     @map("payload_json")
  state           String    @map("state") // received | processing | processed | retry_wait | dead_letter
  attemptCount    Int       @default(0) @map("attempt_count")
  leaseOwner      String?   @map("locked_by")
  leaseLockedAt   DateTime? @map("locked_at")
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  nextAttemptAt   DateTime? @map("next_attempt_at")
  processedAt     DateTime? @map("processed_at")
  lastErrorCode   String?   @map("last_error_code")
  failureCategory String?   @map("failure_category")
  deadLetteredAt  DateTime? @map("dead_lettered_at")
  ownerQueue      String?   @map("owner_queue")
  causationId     String?   @map("causation_id")
  traceId         String    @map("trace_id")
  receivedAt      DateTime  @map("received_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  oceanProviderEventIngestion OceanProviderEventIngestion?

  @@unique([consumerName, messageId], map: "inbox_message_consumer_message_key")
  @@index([tenantId, consumerName, state], map: "inbox_message_tenant_state_idx")
  @@index([tenantId, consumerName, state, leaseExpiresAt, receivedAt], map: "inbox_message_lease_idx")
  @@index([state, nextAttemptAt], map: "inbox_message_retry_idx")
  @@index([tenantId, consumerName, state, deadLetteredAt, id], map: "inbox_message_dead_letter_list_idx")
  @@map("inbox_message")
}

// Inbox 死信人工重放请求：原消息不可改，重放生成新 Inbox received。
model InboxReplayRequest {
  id                    String   @id @default(uuid()) @map("id")
  tenantId              String   @map("tenant_id")
  deadLetterId          String   @map("dead_letter_id")
  replayedInboxId       String   @map("replayed_inbox_id")
  replayedMessageId     String   @map("replayed_message_id")
  targetConsumerVersion String   @map("target_consumer_version")
  requestedBy           String   @map("requested_by")
  reasonCode            String   @map("reason_code")
  requestedAt           DateTime @map("requested_at")
  traceId               String   @map("trace_id")
  idempotencyKey        String   @map("idempotency_key")
  requestHash           String   @map("request_hash")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([tenantId, deadLetterId, idempotencyKey], map: "inbox_replay_idempotency_key")
  @@map("inbox_replay_request")
}

// 海运供应商事件接入留痕（ocean-port-visibility 拥有）。
// 原始载荷与来源裁决追加保存；本表不产生规范事件，也不推进生命周期。
model OceanProviderEventIngestion {
  id                         String       @id @map("id")
  inboxMessageId             String       @unique @map("inbox_message_id")
  inboxMessage               InboxMessage @relation(fields: [inboxMessageId], references: [id], onDelete: Restrict)
  tenantId                   String       @map("tenant_id")
  provider                   String       @map("provider")
  interfaceCode              String       @map("interface_code")
  providerEventIdRaw         String?      @map("provider_event_id_raw")
  idempotencyKey             String?      @map("idempotency_key")
  rawPayload                 Json         @map("raw_payload")
  payloadHash                String       @map("payload_hash")
  payloadHashVersion         String       @map("payload_hash_version")
  containerNumberRaw         String       @map("container_number_raw")
  containerRecordId          String?      @map("container_record_id")
  objectResolutionState      String       @default("not_attempted") @map("object_resolution_state")
  objectResolutionReasonCode String?      @map("object_resolution_reason_code")
  rawCode                    String       @map("raw_code")
  eventTimeRaw               String       @map("event_time_raw")
  mappingVersion             String       @map("mapping_version")
  normalizationKind          String       @map("normalization_kind")
  canonicalEventCode         String?      @map("canonical_event_code")
  occurredAt                 DateTime?    @map("occurred_at") @db.Timestamptz
  timeKind                   String?      @map("time_kind")
  sourceCodeRaw              String       @map("source_code_raw")
  sourceSignal               String?      @map("source_signal")
  authorityDecision          String       @map("authority_decision")
  authorityPolicyRef         String?      @map("authority_policy_ref")
  confidenceState            String       @map("confidence_state")
  reasonCodes                Json         @map("reason_codes")
  lifecycleApplication       String       @map("lifecycle_application")
  decidedBy                  String       @map("decided_by")
  traceId                    String       @map("trace_id")
  receivedAt                 DateTime     @map("received_at") @db.Timestamptz
  decidedAt                  DateTime     @map("decided_at") @db.Timestamptz
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, authorityDecision, receivedAt, id], map: "ocean_provider_ingestion_tenant_decision_idx")
  @@index([tenantId, provider, interfaceCode, idempotencyKey], map: "ocean_provider_ingestion_business_key_idx")
  @@index([tenantId, containerRecordId], map: "ocean_provider_ingestion_container_idx")
  @@map("ocean_provider_event_ingestion")
}

// 契约：GC-009 ClientOperationV1。
// lifecycle-control 写入 lifecycle.apply_event；work-execution 写入 work_execution.complete_work_order。
model ClientOperation {
  id                    String    @id @map("id")
  tenantId              String    @map("tenant_id")
  actorType             String    @map("actor_type")
  actorId               String    @map("actor_id")
  actionCode            String    @map("action_code")
  actionVersion         Int       @map("action_version")
  targetType            String    @map("target_type")
  targetId              String    @map("target_id")
  targetOwnerModule     String    @map("target_owner_module")
  correlationId         String    @map("correlation_id")
  causationId           String?   @map("causation_id")
  traceId               String    @map("trace_id")
  idempotencyKey        String    @map("idempotency_key")
  requestHash           String    @map("request_hash")
  receptionState        String    @map("reception_state")
  businessDecisionState String    @map("business_decision_state")
  commitState           String    @map("commit_state")
  resultRefs            Json      @map("result_refs")
  rejectionReasonCode   String?   @map("rejection_reason_code")
  attemptCount          Int       @default(0) @map("attempt_count")
  lastAttemptAt         DateTime? @map("last_attempt_at")
  nextAttemptAt         DateTime? @map("next_attempt_at")
  receivedAt            DateTime? @map("received_at")
  decidedAt             DateTime? @map("decided_at")
  committedAt           DateTime? @map("committed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, actorId, actionCode, idempotencyKey], map: "client_operation_idempotency_key")
  @@index([tenantId, createdAt, id], map: "client_operation_tenant_created_idx")
  @@map("client_operation")
}

// 契约：GC-009 CompensationRecord。补偿是新事实，不回写 ClientOperation。
model CompensationRecord {
  id                        String   @id @map("id")
  tenantId                  String   @map("tenant_id")
  originalClientOperationId String   @map("original_client_operation_id")
  compensationActionCode    String   @map("compensation_action_code")
  state                     String   @map("state")
  reasonCode                String   @map("reason_code")
  requestedBy               String   @map("requested_by")
  resultRefs                Json     @map("result_refs")
  idempotencyKey            String   @map("idempotency_key")
  requestHash               String   @map("request_hash")
  traceId                   String   @map("trace_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, originalClientOperationId, idempotencyKey], map: "compensation_idempotency_key")
  @@index([tenantId, originalClientOperationId, createdAt, id], map: "compensation_original_idx")
  @@map("compensation_record")
}

// 节点任务（work-execution 拥有）：货柜到节点的工序任务（第一刀最小集）。
model NodeTask {
  id                    String           @id @default(uuid()) @map("id")
  flowInstanceId        String           @map("flow_instance_id")
  nodeInstanceId        String           @map("node_instance_id")
  nodeCode              String           @map("node_code")
  containerId           String?          @map("container_id") // 逻辑引用，无跨模块外键
  taskDefinitionKey     String           @map("task_definition_key")
  state                 String           @map("state") // pending | in_progress | completed
  applicability         String           @default("required") @map("applicability") // required | optional_applicable | optional_not_applicable
  readinessState        String           @default("waiting_conditions") @map("readiness_state") // waiting_conditions | ready
  completionEligibility String           @default("awaiting_evidence") @map("completion_eligibility") // awaiting_evidence | eligible
  conditionFactRefs     Json             @default("[]") @map("condition_fact_refs")
  conditionsEvaluatedAt DateTime         @default(now()) @map("conditions_evaluated_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  workOrders            WorkOrder[]
  outcome               NodeTaskOutcome?

  @@unique([nodeInstanceId])
  @@index([containerId, createdAt, id])
  @@map("node_task")
}

// 作业工单（work-execution 拥有）：任务拆出的工单（第一刀最小集）。
model WorkOrder {
  id                     String    @id @default(uuid()) @map("id")
  nodeTaskId             String    @map("node_task_id")
  nodeTask               NodeTask  @relation(fields: [nodeTaskId], references: [id])
  workOrderDefinitionKey String    @map("work_order_definition_key")
  state                  String    @map("state") // ready | in_progress | completed
  assignmentState        String    @map("assignment_state") // unassigned | assigned | pool | automatic
  assigneeId             String?   @map("assignee_id")
  dueAt                  DateTime? @map("due_at") @db.Timestamptz
  completedAt            DateTime? @map("completed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("work_order")
}

// 非生命周期工作项（work-execution 拥有）：专业模块把整改/义务投影到全局任务池。
// 来源事实仍由专业模块拥有；新版本投影取消旧开放项，不覆盖历史。
model ExternalWorkItemProjection {
  id             String   @id @map("id")
  tenantId       String   @map("tenant_id")
  sourceModule   String   @map("source_module")
  sourceType     String   @map("source_type")
  sourceScopeId  String   @map("source_scope_id")
  sourceRecordId String   @map("source_record_id")
  sourceVersion  Int      @map("source_version")
  payloadHash    String   @map("payload_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, sourceModule, sourceScopeId], map: "external_work_item_projection_scope_key")
  @@map("external_work_item_projection")
}

model ExternalWorkItem {
  id                String    @id @map("id")
  tenantId          String    @map("tenant_id")
  sourceModule      String    @map("source_module")
  sourceType        String    @map("source_type")
  sourceScopeId     String    @map("source_scope_id")
  sourceRecordId    String    @map("source_record_id")
  sourceVersion     Int       @map("source_version")
  sourceItemKey     String    @map("source_item_key")
  containerId       String    @map("container_id") // 跨模块逻辑引用，无外键
  taskDefinitionKey String    @map("task_definition_key")
  title             String    @map("title")
  detail            String    @map("detail")
  priority          String    @map("priority") // low | medium | high | critical
  state             String    @map("state") // open | completed | cancelled
  assignedRoleCode  String    @map("assigned_role_code")
  evidenceRefs      Json      @default("[]") @map("evidence_refs")
  dueAt             DateTime? @map("due_at") @db.Timestamptz
  payloadHash       String    @map("payload_hash")
  closedAt          DateTime? @map("closed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, sourceModule, sourceRecordId, sourceItemKey], map: "external_work_item_source_key")
  @@index([tenantId, state, createdAt, id], map: "external_work_item_tenant_state_idx")
  @@index([tenantId, containerId, state, createdAt, id], map: "external_work_item_container_state_idx")
  @@index([tenantId, sourceModule, sourceScopeId, state], map: "external_work_item_scope_state_idx")
  @@map("external_work_item")
}

// 任务结果快照（work-execution 拥有）：工序聚合结果，不推进生命周期。
// 第一刀 resultPolicy=none；同任务最多一条，重放不重复写。
model NodeTaskOutcome {
  id                    String   @id @default(uuid()) @map("id")
  nodeTaskId            String   @unique @map("node_task_id")
  nodeTask              NodeTask @relation(fields: [nodeTaskId], references: [id])
  previousState         String   @map("previous_state")
  nextState             String   @map("next_state")
  resultPolicyMode      String   @map("result_policy_mode") // none | emit_canonical_event
  eventCode             String?  @map("event_code")
  policySnapshotHash    String   @map("policy_snapshot_hash")
  requiredWorkOrderIds  Json     @map("required_work_order_ids")
  completedWorkOrderIds Json     @map("completed_work_order_ids")
  evaluatedAt           DateTime @map("evaluated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("node_task_outcome")
}

// 计划参数（inland-fulfillment 拥有）：租户键值，禁止源码默认。
model InlandPlanningParameter {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  key       String   @map("key")
  valueText String   @map("value_text")
  unit      String   @map("unit")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key], map: "inland_planning_parameter_tenant_key")
  @@map("inland_planning_parameter")
}

// 计划策略（inland-fulfillment 拥有）：租户策略码，须在注册表内。
model InlandPlanningStrategy {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  key       String   @map("key")
  code      String   @map("code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key], map: "inland_planning_strategy_tenant_key")
  @@map("inland_planning_strategy")
}

// 仓库卸柜日限额（本刀 inland-fulfillment 读写；后续经 master-data 端口）。
model WarehouseUnloadCapacity {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  dailyLimit  Int      @map("daily_limit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, warehouseId], map: "warehouse_unload_capacity_tenant_wh")
  @@map("warehouse_unload_capacity")
}

// 车队运力与是否声明场外缓冲。
model FleetHaulageCapacity {
  id             String   @id @default(uuid()) @map("id")
  tenantId       String   @map("tenant_id")
  fleetId        String   @map("fleet_id")
  dailyTrips     Int      @map("daily_trips")
  bufferDeclared Boolean  @map("buffer_declared")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, fleetId], map: "fleet_haulage_capacity_tenant_fleet")
  @@map("fleet_haulage_capacity")
}

// 港口-车队-仓库分配。没分配的车队不上场。
model PortFleetWarehouseAllocation {
  id             String   @id @default(uuid()) @map("id")
  tenantId       String   @map("tenant_id")
  portId         String   @map("port_id")
  warehouseId    String   @map("warehouse_id")
  fleetId        String   @map("fleet_id")
  assignmentRole String   @map("assignment_role")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, portId, warehouseId, fleetId], map: "port_fleet_wh_alloc_unique")
  @@map("port_fleet_warehouse_allocation")
}

// 内陆计划版本。草稿不完成节点。
model InlandPlan {
  id                    String    @id @default(uuid()) @map("id")
  tenantId              String    @map("tenant_id")
  containerId           String    @map("container_id")
  version               Int       @map("version")
  status                String    @map("status")
  warehouseId           String    @map("warehouse_id")
  portId                String    @map("port_id")
  fleetId               String?   @map("fleet_id")
  pickupAt              DateTime? @map("pickup_at")
  deliveryAt            DateTime? @map("delivery_at")
  unloadAt              DateTime? @map("unload_at")
  returnAt              DateTime? @map("return_at")
  customsMustCompleteBy DateTime? @map("customs_must_complete_by")
  latestPickupAt        DateTime? @map("latest_pickup_at")
  latestReturnAt        DateTime? @map("latest_return_at")
  overdueDeadlinesCode  String?   @map("overdue_deadlines_code")
  schemeCode            String    @map("scheme_code")
  needsHumanDecision    Boolean   @map("needs_human_decision")
  occupied              Boolean   @map("occupied")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, containerId, version], map: "inland_plan_container_version")
  @@index([tenantId, containerId, createdAt, id], map: "inland_plan_container_idx")
  @@map("inland_plan")
}

// 资源占用日历。本刀 confirm_before_occupy 不写入。
model InlandResourceOccupancy {
  id            String   @id @default(uuid()) @map("id")
  tenantId      String   @map("tenant_id")
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  occupancyDate DateTime @map("occupancy_date") @db.Date
  quantity      Int      @map("quantity")
  planId        String   @map("plan_id")
  state         String   @map("state")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, resourceType, resourceId, occupancyDate], map: "inland_occupancy_resource_day")
  @@map("inland_resource_occupancy")
}

// 超期费用标准（charges-settlement 拥有）：免费期与匹配键。费率在阶梯子表。
model OverdueChargeStandard {
  id                 String                  @id @default(uuid()) @map("id")
  tenantId           String                  @map("tenant_id")
  portId             String                  @map("port_id")
  shippingCompanyId  String                  @map("shipping_company_id")
  freightForwarderId String                  @map("freight_forwarder_id")
  chargeType         String                  @map("charge_type")
  freeDays           Int                     @map("free_days")
  freeDaysBasis      String                  @map("free_days_basis")
  calculationBasis   String                  @map("calculation_basis")
  includeStartDay    Boolean                 @map("include_start_day")
  effectiveFrom      DateTime                @map("effective_from")
  effectiveTo        DateTime?               @map("effective_to")
  transportMode      String?                 @map("transport_mode")
  terminalId         String?                 @map("terminal_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  rateTiers          OverdueChargeRateTier[]

  @@index([tenantId, portId, shippingCompanyId, freightForwarderId], map: "overdue_standard_match_idx")
  @@map("overdue_charge_standard")
}

// 超期费用阶梯（charges-settlement 拥有）。金额定点两位小数 + ISO 币种；不算进账单。
model OverdueChargeRateTier {
  id         String                @id @default(uuid()) @map("id")
  tenantId   String                @map("tenant_id")
  standardId String                @map("standard_id")
  fromDay    Int                   @map("from_day")
  toDay      Int?                  @map("to_day")
  amount     Decimal               @map("amount") @db.Decimal(18, 2)
  currency   String                @map("currency")
  createdAt  DateTime              @default(now()) @map("created_at")
  standard   OverdueChargeStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@index([tenantId, standardId], map: "overdue_rate_tier_standard_idx")
  @@map("overdue_charge_rate_tier")
}

// 运营问题通知（notification 拥有）：业务模块经 Port 投递，不直写表。
model OpsNotification {
  id                 String                @id @default(uuid()) @map("id")
  tenantId           String                @map("tenant_id")
  problemCode        String                @map("problem_code")
  severity           String                @map("severity") // low | medium | high | critical
  title              String                @map("title")
  body               String                @map("body")
  entityType         String                @map("entity_type")
  entityId           String                @map("entity_id")
  containerId        String?               @map("container_id") // 跨模块逻辑引用，无外键
  taskId             String?               @map("task_id") // 跨模块逻辑引用，无外键
  workOrderId        String?               @map("work_order_id") // 跨模块逻辑引用，无外键
  recipientRoleCodes String[]              @map("recipient_role_codes")
  conversationHint   String?               @map("conversation_hint")
  occurredAt         DateTime              @map("occurred_at") @db.Timestamptz
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  sessions           OpsAssistantSession[]

  @@index([tenantId, createdAt, id], map: "ops_notification_list_idx")
  @@index([tenantId, containerId, occurredAt, id], map: "ops_notification_container_activity_idx")
  @@index([tenantId, taskId], map: "ops_notification_task_idx")
  @@map("ops_notification")
}

// 运营助手会话（notification 拥有）：可由通知打开；本刀只读问答。
model OpsAssistantSession {
  id             String                @id @default(uuid()) @map("id")
  tenantId       String                @map("tenant_id")
  actorId        String                @map("actor_id")
  notificationId String?               @map("notification_id")
  containerId    String?               @map("container_id") // 跨模块逻辑引用，无外键
  notification   OpsNotification?      @relation(fields: [notificationId], references: [id])
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  messages       OpsAssistantMessage[]

  @@index([tenantId, actorId, createdAt], map: "ops_assistant_session_actor_idx")
  @@index([tenantId, containerId, createdAt], map: "ops_assistant_session_container_idx")
  @@map("ops_assistant_session")
}

model OpsAssistantMessage {
  id        String              @id @default(uuid()) @map("id")
  sessionId String              @map("session_id")
  session   OpsAssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String              @map("role") // system | user | assistant
  body      String              @map("body")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId, createdAt], map: "ops_assistant_message_session_idx")
  @@map("ops_assistant_message")
}
