{
  "name": "@logix/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./index.d.ts",
  "typesVersions": {
    "*": {
      "import-fields.json": [
        "import-fields-json.d.ts"
      ],
      "canonical-events.json": [
        "canonical-events-json.d.ts"
      ],
      "lifecycle-nodes.json": [
        "lifecycle-nodes-json.d.ts"
      ],
      "post-departure-fields.json": [
        "post-departure-fields-json.d.ts"
      ],
      "cargo-owners.json": [
        "catalogs/v1/cargo-owners.json"
      ],
      "post-departure-container-operational-source.json": [
        "fixtures/v1/post-departure-container-operational-source.json"
      ],
      "schemas/v1/common.schema.json": [
        "schemas/v1/common.schema.json"
      ],
      "schemas/v1/shipment-handoff.schema.json": [
        "schemas/v1/shipment-handoff.schema.json"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./import-fields.json": {
      "types": "./import-fields-json.d.ts",
      "default": "./catalogs/v1/import-fields.json"
    },
    "./canonical-events.json": {
      "types": "./canonical-events-json.d.ts",
      "default": "./catalogs/v1/canonical-events.json"
    },
    "./lifecycle-nodes.json": {
      "types": "./lifecycle-nodes-json.d.ts",
      "default": "./catalogs/v1/lifecycle-nodes.json"
    },
    "./post-departure-fields.json": {
      "types": "./post-departure-fields-json.d.ts",
      "default": "./catalogs/v1/post-departure-fields.json"
    },
    "./cargo-owners.json": {
      "default": "./catalogs/v1/cargo-owners.json"
    },
    "./post-departure-container-operational-source.json": {
      "default": "./fixtures/v1/post-departure-container-operational-source.json"
    },
    "./schemas/v1/common.schema.json": {
      "default": "./schemas/v1/common.schema.json"
    },
    "./schemas/v1/shipment-handoff.schema.json": {
      "default": "./schemas/v1/shipment-handoff.schema.json"
    },
    "./lifecycle-date-fact-inbox": {
      "types": "./lifecycle-date-fact-inbox.d.ts",
      "default": "./lifecycle-date-fact-inbox.js"
    },
    "./post-departure-lifecycle": {
      "types": "./post-departure-lifecycle.d.ts",
      "default": "./post-departure-lifecycle.js"
    },
    "./action-catalog": {
      "types": "./action-catalog.d.ts",
      "default": "./action-catalog.js"
    }
  },
  "scripts": {
    "contract:check": "node ../../scripts/validate-contract-schemas.mjs",
    "contract:generate": "node ../../scripts/generate-contracts.mjs",
    "contract:drift": "node ../../scripts/generate-contracts.mjs --check"
  }
}
