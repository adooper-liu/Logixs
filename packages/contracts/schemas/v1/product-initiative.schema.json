{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logixs.internal/contracts/v1/product-initiative.schema.json",
  "title": "Product Initiative Contracts V1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ProductInitiativeReviewPointCodeV1": {
      "description": "立项评审要点。`customer_feedback` 由「售后原声」这类专业要求喂证据 —— 没有它，那些证据收了却没有地方形成结论。**它不进立项硬门槛**：加第 5 项门槛会让存量记录追溯性变成不合格。",
      "enum": [
        "target_user_and_market",
        "competitive_supply",
        "price_band_and_margin",
        "compliance_risk",
        "customer_feedback"
      ]
    },
    "ProductInitiativeOutcomeV1": {
      "description": "选品立项 decision 命令可用去向。不含 `returned_from_npi`（仅 NPI 退回写口）。",
      "enum": ["approve", "defer", "reject", "return_to_market"]
    },
    "ProductInitiativeStoredOutcomeV1": {
      "description": "立项行已落库的 outcome，含 NPI→选品退回。",
      "enum": [
        "approve",
        "defer",
        "reject",
        "return_to_market",
        "returned_from_npi"
      ]
    },
    "ProductInitiativeCompletionV1": {
      "enum": ["pending_completion", "completed"]
    },
    "ProductInitiativeReturnBasisV1": {
      "enum": ["insufficient_evidence", "wrong_direction"]
    },
    "ProductInitiativeDestinationV1": {
      "enum": [
        "needs_decision",
        "deferred",
        "rejected",
        "return_requested",
        "returned_to_market",
        "handed_off",
        "returned_from_npi"
      ]
    },
    "ProductInitiativeUnitEconomicsPendingFieldCodeV1": {
      "enum": [
        "unitEconomics.marketCode",
        "unitEconomics.channelCode",
        "unitEconomics.currencyCode",
        "unitEconomics.scenarios.baseline.salePrice.min",
        "unitEconomics.scenarios.baseline.salePrice.max",
        "unitEconomics.scenarios.baseline.salePrice.basis",
        "unitEconomics.scenarios.baseline.salePrice.evidenceRefs",
        "unitEconomics.scenarios.baseline.landedCost.min",
        "unitEconomics.scenarios.baseline.landedCost.max",
        "unitEconomics.scenarios.baseline.landedCost.basis",
        "unitEconomics.scenarios.baseline.landedCost.evidenceRefs",
        "unitEconomics.scenarios.baseline.platformFee.min",
        "unitEconomics.scenarios.baseline.platformFee.max",
        "unitEconomics.scenarios.baseline.platformFee.basis",
        "unitEconomics.scenarios.baseline.platformFee.evidenceRefs",
        "unitEconomics.scenarios.baseline.fulfillmentFee.min",
        "unitEconomics.scenarios.baseline.fulfillmentFee.max",
        "unitEconomics.scenarios.baseline.fulfillmentFee.basis",
        "unitEconomics.scenarios.baseline.fulfillmentFee.evidenceRefs",
        "unitEconomics.scenarios.baseline.advertisingCost.min",
        "unitEconomics.scenarios.baseline.advertisingCost.max",
        "unitEconomics.scenarios.baseline.advertisingCost.basis",
        "unitEconomics.scenarios.baseline.advertisingCost.evidenceRefs",
        "unitEconomics.scenarios.baseline.returnCost.min",
        "unitEconomics.scenarios.baseline.returnCost.max",
        "unitEconomics.scenarios.baseline.returnCost.basis",
        "unitEconomics.scenarios.baseline.returnCost.evidenceRefs",
        "unitEconomics.scenarios.conservative.salePrice.min",
        "unitEconomics.scenarios.conservative.salePrice.max",
        "unitEconomics.scenarios.conservative.salePrice.basis",
        "unitEconomics.scenarios.conservative.salePrice.evidenceRefs",
        "unitEconomics.scenarios.conservative.landedCost.min",
        "unitEconomics.scenarios.conservative.landedCost.max",
        "unitEconomics.scenarios.conservative.landedCost.basis",
        "unitEconomics.scenarios.conservative.landedCost.evidenceRefs",
        "unitEconomics.scenarios.conservative.platformFee.min",
        "unitEconomics.scenarios.conservative.platformFee.max",
        "unitEconomics.scenarios.conservative.platformFee.basis",
        "unitEconomics.scenarios.conservative.platformFee.evidenceRefs",
        "unitEconomics.scenarios.conservative.fulfillmentFee.min",
        "unitEconomics.scenarios.conservative.fulfillmentFee.max",
        "unitEconomics.scenarios.conservative.fulfillmentFee.basis",
        "unitEconomics.scenarios.conservative.fulfillmentFee.evidenceRefs",
        "unitEconomics.scenarios.conservative.advertisingCost.min",
        "unitEconomics.scenarios.conservative.advertisingCost.max",
        "unitEconomics.scenarios.conservative.advertisingCost.basis",
        "unitEconomics.scenarios.conservative.advertisingCost.evidenceRefs",
        "unitEconomics.scenarios.conservative.returnCost.min",
        "unitEconomics.scenarios.conservative.returnCost.max",
        "unitEconomics.scenarios.conservative.returnCost.basis",
        "unitEconomics.scenarios.conservative.returnCost.evidenceRefs",
        "negativeConservativeReason"
      ]
    },
    "ProductInitiativePendingFieldCodeV1": {
      "enum": [
        "objective",
        "target_user_and_market",
        "competitive_supply",
        "price_band_and_margin",
        "compliance_risk",
        "customer_feedback",
        "customer_need",
        "value_differentiation",
        "commercial_viability",
        "supply_technical_feasibility",
        "strategy_portfolio",
        "defer_reason",
        "responsibility_commitment",
        "receiving_team_or_role",
        "resource_description",
        "target_date",
        "next_decision_date",
        "next_decision_question",
        "validation_focus",
        "reconsideration_date",
        "reject_reason",
        "return_basis",
        "return_reason",
        "risk.compliance",
        "risk.intellectual_property",
        "risk.packaging_logistics",
        "risk.returns",
        "risk.platform_restrictions",
        "unitEconomics.marketCode",
        "unitEconomics.channelCode",
        "unitEconomics.currencyCode",
        "unitEconomics.scenarios.baseline.salePrice.min",
        "unitEconomics.scenarios.baseline.salePrice.max",
        "unitEconomics.scenarios.baseline.salePrice.basis",
        "unitEconomics.scenarios.baseline.salePrice.evidenceRefs",
        "unitEconomics.scenarios.baseline.landedCost.min",
        "unitEconomics.scenarios.baseline.landedCost.max",
        "unitEconomics.scenarios.baseline.landedCost.basis",
        "unitEconomics.scenarios.baseline.landedCost.evidenceRefs",
        "unitEconomics.scenarios.baseline.platformFee.min",
        "unitEconomics.scenarios.baseline.platformFee.max",
        "unitEconomics.scenarios.baseline.platformFee.basis",
        "unitEconomics.scenarios.baseline.platformFee.evidenceRefs",
        "unitEconomics.scenarios.baseline.fulfillmentFee.min",
        "unitEconomics.scenarios.baseline.fulfillmentFee.max",
        "unitEconomics.scenarios.baseline.fulfillmentFee.basis",
        "unitEconomics.scenarios.baseline.fulfillmentFee.evidenceRefs",
        "unitEconomics.scenarios.baseline.advertisingCost.min",
        "unitEconomics.scenarios.baseline.advertisingCost.max",
        "unitEconomics.scenarios.baseline.advertisingCost.basis",
        "unitEconomics.scenarios.baseline.advertisingCost.evidenceRefs",
        "unitEconomics.scenarios.baseline.returnCost.min",
        "unitEconomics.scenarios.baseline.returnCost.max",
        "unitEconomics.scenarios.baseline.returnCost.basis",
        "unitEconomics.scenarios.baseline.returnCost.evidenceRefs",
        "unitEconomics.scenarios.conservative.salePrice.min",
        "unitEconomics.scenarios.conservative.salePrice.max",
        "unitEconomics.scenarios.conservative.salePrice.basis",
        "unitEconomics.scenarios.conservative.salePrice.evidenceRefs",
        "unitEconomics.scenarios.conservative.landedCost.min",
        "unitEconomics.scenarios.conservative.landedCost.max",
        "unitEconomics.scenarios.conservative.landedCost.basis",
        "unitEconomics.scenarios.conservative.landedCost.evidenceRefs",
        "unitEconomics.scenarios.conservative.platformFee.min",
        "unitEconomics.scenarios.conservative.platformFee.max",
        "unitEconomics.scenarios.conservative.platformFee.basis",
        "unitEconomics.scenarios.conservative.platformFee.evidenceRefs",
        "unitEconomics.scenarios.conservative.fulfillmentFee.min",
        "unitEconomics.scenarios.conservative.fulfillmentFee.max",
        "unitEconomics.scenarios.conservative.fulfillmentFee.basis",
        "unitEconomics.scenarios.conservative.fulfillmentFee.evidenceRefs",
        "unitEconomics.scenarios.conservative.advertisingCost.min",
        "unitEconomics.scenarios.conservative.advertisingCost.max",
        "unitEconomics.scenarios.conservative.advertisingCost.basis",
        "unitEconomics.scenarios.conservative.advertisingCost.evidenceRefs",
        "unitEconomics.scenarios.conservative.returnCost.min",
        "unitEconomics.scenarios.conservative.returnCost.max",
        "unitEconomics.scenarios.conservative.returnCost.basis",
        "unitEconomics.scenarios.conservative.returnCost.evidenceRefs",
        "negativeConservativeReason"
      ]
    },
    "ProductInitiativeReviewPointV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "evidenceRefs"],
      "properties": {
        "code": { "$ref": "#/$defs/ProductInitiativeReviewPointCodeV1" },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "conclusion": { "type": ["string", "null"], "maxLength": 4000 }
      }
    },
    "ProductInitiativeRiskCodeV1": {
      "enum": [
        "compliance",
        "intellectual_property",
        "packaging_logistics",
        "returns",
        "platform_restrictions"
      ]
    },
    "ProductInitiativeRiskApplicabilityV1": {
      "enum": ["applicable", "not_applicable", "undetermined"]
    },
    "ProductInitiativeRiskInvestmentDecisionV1": {
      "enum": [
        "supports_investment",
        "validate_before_investment",
        "does_not_support"
      ]
    },
    "ProductInitiativeRiskAssessmentDraftV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskCode", "applicability", "evidenceRefs"],
      "properties": {
        "riskCode": { "$ref": "#/$defs/ProductInitiativeRiskCodeV1" },
        "applicability": {
          "$ref": "#/$defs/ProductInitiativeRiskApplicabilityV1"
        },
        "applicabilityReason": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "investmentDecision": {
          "anyOf": [
            { "$ref": "#/$defs/ProductInitiativeRiskInvestmentDecisionV1" },
            { "type": "null" }
          ]
        },
        "conclusion": { "type": ["string", "null"], "maxLength": 4000 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "criticalUnknown": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "applicability": { "const": "not_applicable" } },
            "required": ["applicability"]
          },
          "then": {
            "required": ["applicabilityReason"],
            "properties": {
              "applicabilityReason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "investmentDecision": { "type": "null" },
              "conclusion": { "type": "null" },
              "criticalUnknown": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "applicability": { "const": "undetermined" } },
            "required": ["applicability"]
          },
          "then": {
            "required": ["criticalUnknown"],
            "properties": {
              "applicabilityReason": { "type": "null" },
              "investmentDecision": { "type": "null" },
              "conclusion": { "type": "null" },
              "criticalUnknown": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "applicability": { "const": "applicable" } },
            "required": ["applicability"]
          },
          "then": {
            "required": ["investmentDecision", "conclusion"],
            "properties": {
              "applicabilityReason": { "type": "null" },
              "conclusion": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidenceRefs": { "minItems": 1 }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "investmentDecision": {
                      "const": "validate_before_investment"
                    }
                  },
                  "required": ["investmentDecision"]
                },
                "then": {
                  "required": ["criticalUnknown"],
                  "properties": {
                    "criticalUnknown": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "else": {
                  "properties": { "criticalUnknown": { "type": "null" } }
                }
              }
            ]
          }
        }
      ]
    },
    "ProductInitiativeRiskAssessmentSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskCode",
        "applicability",
        "applicabilityReason",
        "investmentDecision",
        "conclusion",
        "evidenceRefs",
        "criticalUnknown"
      ],
      "properties": {
        "riskCode": { "$ref": "#/$defs/ProductInitiativeRiskCodeV1" },
        "applicability": { "enum": ["not_applicable", "applicable"] },
        "applicabilityReason": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "investmentDecision": {
          "anyOf": [
            { "$ref": "#/$defs/ProductInitiativeRiskInvestmentDecisionV1" },
            { "type": "null" }
          ]
        },
        "conclusion": { "type": ["string", "null"], "maxLength": 4000 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "criticalUnknown": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "applicability": { "const": "not_applicable" } },
            "required": ["applicability"]
          },
          "then": {
            "required": ["applicabilityReason"],
            "properties": {
              "applicabilityReason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "investmentDecision": { "type": "null" },
              "conclusion": { "type": "null" },
              "criticalUnknown": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "applicability": { "const": "undetermined" } },
            "required": ["applicability"]
          },
          "then": {
            "properties": {
              "applicabilityReason": { "type": "null" },
              "investmentDecision": { "type": "null" },
              "conclusion": { "type": "null" },
              "criticalUnknown": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "applicability": { "const": "applicable" } },
            "required": ["applicability"]
          },
          "then": {
            "properties": {
              "applicabilityReason": { "type": "null" },
              "investmentDecision": { "const": "supports_investment" },
              "conclusion": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "criticalUnknown": { "type": "null" }
            },
            "required": ["conclusion"]
          }
        }
      ]
    },
    "ProductInitiativeBusinessCaseDimensionCodeV1": {
      "enum": [
        "customer_need",
        "value_differentiation",
        "commercial_viability",
        "supply_technical_feasibility",
        "strategy_portfolio"
      ]
    },
    "ProductInitiativeBusinessCaseDecisionV1": {
      "enum": [
        "supports_investment",
        "validate_before_investment",
        "does_not_support"
      ]
    },
    "ProductInitiativeBusinessCaseDimensionDraftV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensionCode", "evidenceRefs"],
      "properties": {
        "dimensionCode": {
          "$ref": "#/$defs/ProductInitiativeBusinessCaseDimensionCodeV1"
        },
        "decision": {
          "$ref": "#/$defs/ProductInitiativeBusinessCaseDecisionV1"
        },
        "conclusion": { "type": ["string", "null"], "maxLength": 4000 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "criticalUnknown": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": { "const": "validate_before_investment" }
            },
            "required": ["decision"]
          },
          "then": {
            "required": ["criticalUnknown"],
            "properties": {
              "criticalUnknown": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": { "criticalUnknown": { "type": "null" } }
          }
        }
      ]
    },
    "ProductInitiativeBusinessCaseDimensionSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensionCode",
        "decision",
        "conclusion",
        "evidenceRefs",
        "criticalUnknown"
      ],
      "properties": {
        "dimensionCode": {
          "$ref": "#/$defs/ProductInitiativeBusinessCaseDimensionCodeV1"
        },
        "decision": { "const": "supports_investment" },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "criticalUnknown": { "type": "null" }
      }
    },
    "ProductInitiativeBusinessCaseDuplicateDimensionCodesV1": {
      "anyOf": [
        {
          "contains": {
            "type": "object",
            "required": ["dimensionCode"],
            "properties": { "dimensionCode": { "const": "customer_need" } }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["dimensionCode"],
            "properties": {
              "dimensionCode": { "const": "value_differentiation" }
            }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["dimensionCode"],
            "properties": {
              "dimensionCode": { "const": "commercial_viability" }
            }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["dimensionCode"],
            "properties": {
              "dimensionCode": { "const": "supply_technical_feasibility" }
            }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["dimensionCode"],
            "properties": { "dimensionCode": { "const": "strategy_portfolio" } }
          },
          "minContains": 2
        }
      ]
    },
    "ProductInitiativeDuplicateRiskCodesV1": {
      "anyOf": [
        {
          "contains": {
            "type": "object",
            "required": ["riskCode"],
            "properties": { "riskCode": { "const": "compliance" } }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["riskCode"],
            "properties": { "riskCode": { "const": "intellectual_property" } }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["riskCode"],
            "properties": { "riskCode": { "const": "packaging_logistics" } }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["riskCode"],
            "properties": { "riskCode": { "const": "returns" } }
          },
          "minContains": 2
        },
        {
          "contains": {
            "type": "object",
            "required": ["riskCode"],
            "properties": { "riskCode": { "const": "platform_restrictions" } }
          },
          "minContains": 2
        }
      ]
    },
    "ProductInitiativeUnitEconomicsBasisV1": {
      "enum": ["evidence", "assumption"]
    },
    "ProductInitiativeUnitEconomicsRangeDraftV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,4})?$"
        },
        "max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,4})?$"
        },
        "basis": { "$ref": "#/$defs/ProductInitiativeUnitEconomicsBasisV1" },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "basis": { "const": "assumption" } },
            "required": ["basis"]
          },
          "then": {
            "properties": { "evidenceRefs": { "maxItems": 0 } }
          }
        }
      ]
    },
    "ProductInitiativeUnitEconomicsRangeSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "basis", "evidenceRefs"],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,4})?$"
        },
        "max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,4})?$"
        },
        "basis": { "$ref": "#/$defs/ProductInitiativeUnitEconomicsBasisV1" },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "basis": { "const": "evidence" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } },
          "else": { "properties": { "evidenceRefs": { "maxItems": 0 } } }
        }
      ]
    },
    "ProductInitiativeUnitEconomicsScenarioDraftV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "salePrice": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeDraftV1"
        },
        "landedCost": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeDraftV1"
        },
        "platformFee": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeDraftV1"
        },
        "fulfillmentFee": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeDraftV1"
        },
        "advertisingCost": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeDraftV1"
        },
        "returnCost": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeDraftV1"
        }
      }
    },
    "ProductInitiativeUnitEconomicsScenarioSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salePrice",
        "landedCost",
        "platformFee",
        "fulfillmentFee",
        "advertisingCost",
        "returnCost",
        "contribution"
      ],
      "properties": {
        "salePrice": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeSnapshotV1"
        },
        "landedCost": {
          "$ref": "#/$defs/ProductInitiativeUnitEconomicsRangeSnapshotV1"
        },
        "platformFee": {
