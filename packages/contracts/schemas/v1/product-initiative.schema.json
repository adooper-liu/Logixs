{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logixs.internal/contracts/v1/product-initiative.schema.json",
  "title": "Product Initiative Contracts V1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ProductInitiativeReviewPointCodeV1": {
      "description": "立项评审要点。`customer_feedback` 由「售后原声」这类专业要求喂证据 —— 没有它，那些证据收了却没有地方形成结论。**它不进立项硬门槛**：加第 5 项门槛会让存量记录追溯性变成不合格。",
      "enum": [
        "target_user_and_market",
        "competitive_supply",
        "price_band_and_margin",
        "compliance_risk",
        "customer_feedback"
      ]
    },
    "ProductInitiativeOutcomeV1": {
      "description": "选品立项 decision 命令可用去向。不含 `returned_from_npi`（仅 NPI 退回写口）。",
      "enum": ["approve", "defer", "reject", "return_to_market"]
    },
    "ProductInitiativeStoredOutcomeV1": {
      "description": "立项行已落库的 outcome，含 NPI→选品退回。",
      "enum": [
        "approve",
        "defer",
        "reject",
        "return_to_market",
        "returned_from_npi"
      ]
    },
    "ProductInitiativeCompletionV1": {
      "enum": ["pending_completion", "completed"]
    },
    "ProductInitiativeDestinationV1": {
      "enum": [
        "needs_decision",
        "deferred",
        "rejected",
        "returned_to_market",
        "handed_off",
        "returned_from_npi"
      ]
    },
    "ProductInitiativePendingFieldCodeV1": {
      "enum": [
        "objective",
        "target_user_and_market",
        "competitive_supply",
        "price_band_and_margin",
        "compliance_risk",
        "customer_feedback",
        "defer_reason",
        "reject_reason",
        "return_reason"
      ]
    },
    "ProductInitiativeReviewPointV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "evidenceRefs"],
      "properties": {
        "code": { "$ref": "#/$defs/ProductInitiativeReviewPointCodeV1" },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "conclusion": { "type": ["string", "null"], "maxLength": 4000 }
      }
    },
    "ProductInitiativeDecisionCommandV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "outcome",
        "expectedInitiativeVersion",
        "reviewPoints",
        "idempotencyKey"
      ],
      "properties": {
        "contractVersion": { "const": "product-initiative-decision.v1" },
        "requestId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "outcome": { "$ref": "#/$defs/ProductInitiativeOutcomeV1" },
        "expectedInitiativeVersion": { "type": "integer", "minimum": 0 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reviewPoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProductInitiativeReviewPointV1" }
        },
        "deferReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rejectReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "returnReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "ProductInitiativeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiativeId",
        "outcome",
        "completion",
        "currentDestination",
        "responsibleActorId",
        "reviewPoints",
        "pendingFieldCodes",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "initiativeId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "outcome": { "$ref": "#/$defs/ProductInitiativeStoredOutcomeV1" },
        "completion": { "$ref": "#/$defs/ProductInitiativeCompletionV1" },
        "currentDestination": {
          "$ref": "#/$defs/ProductInitiativeDestinationV1"
        },
        "responsibleActorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": { "type": ["string", "null"], "maxLength": 4000 },
        "reviewPoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProductInitiativeReviewPointV1" }
        },
        "reason": { "type": ["string", "null"], "maxLength": 500 },
        "pendingFieldCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ProductInitiativePendingFieldCodeV1" }
        },
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "ProductInitiativeEvidenceCandidateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceName",
        "summary",
        "contentRef",
        "recordedAt"
      ],
      "properties": {
        "evidenceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "sourceName": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contentRef": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recordedAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "ProductInitiativeDetailV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoffId", "evidenceCandidates"],
      "properties": {
        "handoffId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "initiative": {
          "anyOf": [
            { "$ref": "#/$defs/ProductInitiativeV1" },
            { "type": "null" }
          ]
        },
        "evidenceCandidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProductInitiativeEvidenceCandidateV1" }
        }
      }
    },
    "ProductInitiativeQueueEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoffId",
        "outcome",
        "currentDestination",
        "pendingFieldCodes",
        "updatedAt"
      ],
      "properties": {
        "handoffId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "outcome": { "$ref": "#/$defs/ProductInitiativeStoredOutcomeV1" },
        "currentDestination": {
          "$ref": "#/$defs/ProductInitiativeDestinationV1"
        },
        "pendingFieldCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ProductInitiativePendingFieldCodeV1" }
        },
        "updatedAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "ProductInitiativeQueuePageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "items", "pageSize", "nextCursor"],
      "properties": {
        "contractVersion": { "const": "product-initiative-queue.v1" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProductInitiativeQueueEntryV1" }
        },
        "pageSize": { "type": "integer", "minimum": 1 },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "ProductInitiativeHandoffV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "handoffId",
        "version",
        "initiativeId",
        "signalId",
        "objective",
        "responsibleActorId",
        "reviewPoints",
        "evidenceRefs",
        "createdAt",
        "idempotencyKey"
      ],
      "properties": {
        "contractVersion": { "const": "product_initiative_handoff.v1" },
        "handoffId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "initiativeId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "signalId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "marketCode": { "type": ["string", "null"], "maxLength": 100 },
        "userProblem": { "type": ["string", "null"], "maxLength": 4000 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "responsibleActorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewPoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProductInitiativeReviewPointV1" }
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "ProductInitiativeNpiClaimV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "handoffId",
        "claimVersion",
        "productOwnerActorId",
        "claimedAt"
      ],
      "properties": {
        "claimId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "handoffId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "claimVersion": { "type": "integer", "minimum": 1 },
        "productOwnerActorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "claimedAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "ProductInitiativeClaimCommandV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "expectedClaimVersion", "idempotencyKey"],
      "properties": {
        "contractVersion": { "const": "product-initiative-claim.v1" },
        "expectedClaimVersion": { "type": "integer", "minimum": 0 },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "ProductInitiativeNpiReturnCommandV1": {
      "description": "NPI 将已领取立项退回选品。理由必填才关闭；缺理由不得回推选品。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "expectedInitiativeVersion",
        "returnReason",
        "idempotencyKey"
      ],
      "properties": {
        "contractVersion": { "const": "product-initiative-npi-return.v1" },
        "expectedInitiativeVersion": { "type": "integer", "minimum": 1 },
        "returnReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "ProductInitiativeNpiQueueEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff", "claim", "initiativeVersion", "initiativeDestination"],
      "properties": {
        "handoff": { "$ref": "#/$defs/ProductInitiativeHandoffV1" },
        "claim": {
          "anyOf": [
            { "$ref": "#/$defs/ProductInitiativeNpiClaimV1" },
            { "type": "null" }
          ]
        },
        "initiativeVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "立项当前版本；退回时作 expectedInitiativeVersion。"
        },
        "initiativeDestination": {
          "$ref": "#/$defs/ProductInitiativeDestinationV1"
        }
      }
    },
    "ProductInitiativeNpiQueuePageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "items", "pageSize", "nextCursor"],
      "properties": {
        "contractVersion": { "const": "product-initiative-npi-queue.v1" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProductInitiativeNpiQueueEntryV1" }
        },
        "pageSize": { "type": "integer", "minimum": 1 },
        "nextCursor": { "type": ["string", "null"] }
      }
    }
  }
}
