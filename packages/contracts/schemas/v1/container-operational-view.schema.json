{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logixs.internal/contracts/v1/container-operational-view.schema.json",
  "title": "ContainerOperationalViewV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "containerId",
    "containerNumber",
    "flow",
    "currentNode",
    "nodes",
    "currentTimes",
    "tasks",
    "workOrders",
    "professionalFacts",
    "evidenceSummary",
    "syncSummary",
    "activeBlocks",
    "activeExceptions",
    "allowedActions",
    "projectionVersion",
    "sourceVersions",
    "asOf",
    "freshness"
  ],
  "properties": {
    "tenantId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "containerId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "containerNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
    "shipment": {
      "oneOf": [
        { "$ref": "#/$defs/ContainerShipmentContextV1" },
        { "type": "null" }
      ]
    },
    "flow": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["flowInstanceId", "state", "definitionVersion", "version"],
      "properties": {
        "flowInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "state": { "$ref": "common.schema.json#/$defs/FlowInstanceState" },
        "definitionVersion": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "currentNode": {
      "oneOf": [{ "$ref": "#/$defs/NodeSummary" }, { "type": "null" }]
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/NodeSummary" } },
    "currentTimes": { "$ref": "#/$defs/CurrentTimeSummary" },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/TaskSummary" } },
    "workOrders": {
      "type": "array",
      "items": { "$ref": "#/$defs/WorkOrderSummary" }
    },
    "professionalFacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/ProfessionalFactSummary" }
    },
    "evidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "effective",
        "pending",
        "disputed",
        "evidenceRefs",
        "restrictedEvidencePresent"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "effective": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "disputed": { "type": "integer", "minimum": 0 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "restrictedEvidencePresent": { "type": "boolean" }
      }
    },
    "syncSummary": {
      "type": "object",
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/SyncOperationSummary" }
        }
      }
    },
    "activeBlocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/BlockSummary" }
    },
    "activeExceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExceptionSummary" }
    },
    "allowedActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/AllowedAction" }
    },
    "projectionVersion": { "type": "integer", "minimum": 0 },
    "sourceVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "version"],
        "properties": {
          "source": { "$ref": "common.schema.json#/$defs/StableCode" },
          "version": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "asOf": { "$ref": "common.schema.json#/$defs/DateTime" },
    "freshness": { "$ref": "#/$defs/Freshness" }
  },
  "$defs": {
    "NodeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeInstanceId",
        "nodeCode",
        "sequence",
        "activationNo",
        "applicability",
        "state",
        "activeBlockCount",
        "taskProgress",
        "version"
      ],
      "properties": {
        "nodeInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "nodeCode": { "$ref": "common.schema.json#/$defs/LifecycleNodeCode" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 14 },
        "activationNo": { "type": "integer", "minimum": 1 },
        "applicability": {
          "$ref": "common.schema.json#/$defs/NodeApplicability"
        },
        "state": { "$ref": "common.schema.json#/$defs/LifecycleNodeState" },
        "plannedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "estimatedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "actualAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "activeBlockCount": { "type": "integer", "minimum": 0 },
        "taskProgress": {
          "type": "object",
          "required": ["required", "completed", "blocked"],
          "properties": {
            "required": { "type": "integer", "minimum": 0 },
            "completed": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 }
          }
        },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "TaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeTaskId",
        "nodeInstanceId",
        "taskDefinitionKey",
        "taskDefinitionVersion",
        "state",
        "applicability",
        "readinessState",
        "completionEligibility",
        "conditionFactRefs",
        "requiredWorkOrderCount",
        "completedWorkOrderCount",
        "activeBlockRefs",
        "factApplicationRefs",
        "version"
      ],
      "properties": {
        "nodeTaskId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "nodeInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "taskDefinitionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "taskDefinitionVersion": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "common.schema.json#/$defs/NodeTaskState" },
        "applicability": {
          "$ref": "common.schema.json#/$defs/NodeApplicability"
        },
        "readinessState": {
          "$ref": "common.schema.json#/$defs/TaskReadinessState"
        },
        "completionEligibility": {
          "$ref": "common.schema.json#/$defs/TaskCompletionEligibility"
        },
        "conditionFactRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "ownerRef": { "$ref": "common.schema.json#/$defs/EntityRef" },
        "dueAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "requiredWorkOrderCount": { "type": "integer", "minimum": 0 },
        "completedWorkOrderCount": { "type": "integer", "minimum": 0 },
        "activeBlockRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "factApplicationRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "WorkOrderSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workOrderId",
        "nodeTaskId",
        "workOrderDefinitionKey",
        "workOrderDefinitionVersion",
        "state",
        "applicability",
        "assignmentState",
        "completionPredicateCount",
        "satisfiedPredicateCount",
        "activeBlockRefs",
        "factApplicationRefs",
        "version"
      ],
      "properties": {
        "workOrderId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "nodeTaskId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "workOrderDefinitionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "workOrderDefinitionVersion": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "common.schema.json#/$defs/WorkOrderState" },
        "applicability": {
          "$ref": "common.schema.json#/$defs/WorkOrderApplicability"
        },
        "assignmentState": {
          "$ref": "common.schema.json#/$defs/AssignmentState"
        },
        "assigneeRef": { "$ref": "common.schema.json#/$defs/EntityRef" },
        "dueAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "completionPredicateCount": { "type": "integer", "minimum": 0 },
        "satisfiedPredicateCount": { "type": "integer", "minimum": 0 },
        "activeBlockRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "factApplicationRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "ProfessionalFactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainFactId",
        "factType",
        "occurredAt",
        "validity",
        "confidenceState",
        "evidenceRefs"
      ],
      "properties": {
        "domainFactId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "factType": { "$ref": "common.schema.json#/$defs/StableCode" },
        "occurredAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "validity": { "$ref": "common.schema.json#/$defs/EvidenceValidity" },
        "confidenceState": {
          "$ref": "common.schema.json#/$defs/ConfidenceState"
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        }
      }
    },
    "SyncOperationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientOperationId",
        "receptionState",
        "businessDecisionState",
        "commitState",
        "attemptCount",
        "traceId"
      ],
      "properties": {
        "clientOperationId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "receptionState": {
          "$ref": "common.schema.json#/$defs/ReceptionState"
        },
        "businessDecisionState": {
          "$ref": "common.schema.json#/$defs/BusinessDecisionState"
        },
        "commitState": { "$ref": "common.schema.json#/$defs/CommitState" },
        "attemptCount": { "type": "integer", "minimum": 0 },
        "lastAttemptAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "nextAttemptAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "failureCode": { "type": "string", "minLength": 1, "maxLength": 100 },
        "traceId": { "type": "string", "minLength": 1 }
      }
    },
    "AllowedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionCode",
        "actionVersion",
        "target",
        "executable",
        "confirmationPolicy",
        "reviewPolicy",
        "requiredEvidenceTypes",
        "expectedVersion"
      ],
      "properties": {
        "actionCode": { "$ref": "common.schema.json#/$defs/StableCode" },
        "actionVersion": { "type": "integer", "minimum": 1 },
        "target": { "$ref": "common.schema.json#/$defs/EntityRef" },
        "executable": { "type": "boolean" },
        "denialCategory": {
          "$ref": "common.schema.json#/$defs/DenialCategory"
        },
        "confirmationPolicy": {
          "$ref": "common.schema.json#/$defs/ConfirmationPolicy"
        },
        "reviewPolicy": {
          "$ref": "common.schema.json#/$defs/ReviewPolicy"
        },
        "requiredEvidenceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/StableCode" }
        },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "expiresAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "TimeSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCode"],
      "properties": {
        "nodeCode": { "$ref": "common.schema.json#/$defs/LifecycleNodeCode" },
        "segmentId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "plannedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "estimatedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "actualAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "CurrentTimeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeTimes", "segmentTimes"],
      "properties": {
        "nodeTimes": {
          "type": "array",
          "items": { "$ref": "#/$defs/TimeSlot" }
        },
        "segmentTimes": {
          "type": "array",
          "items": { "$ref": "#/$defs/TimeSlot" }
        }
      }
    },
    "BlockSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "target",
        "blockType",
        "reasonCode",
        "occurredAt"
      ],
      "properties": {
        "blockId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "target": { "$ref": "common.schema.json#/$defs/EntityRef" },
        "blockType": { "$ref": "common.schema.json#/$defs/StableCode" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "occurredAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "ownerRef": { "$ref": "common.schema.json#/$defs/EntityRef" }
      }
    },
    "ExceptionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exceptionId",
        "target",
        "exceptionCode",
        "severity",
        "occurredAt"
      ],
      "properties": {
        "exceptionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "target": { "$ref": "common.schema.json#/$defs/EntityRef" },
        "exceptionCode": { "$ref": "common.schema.json#/$defs/StableCode" },
        "severity": { "$ref": "common.schema.json#/$defs/StableCode" },
        "occurredAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "PageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextCursor", "hasNextPage", "pageSize"],
      "properties": {
        "nextCursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2048
        },
        "hasNextPage": { "type": "boolean" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "ContainerOperationalPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "pageInfo", "asOf", "projectionVersion"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#" } },
        "pageInfo": { "$ref": "#/$defs/PageInfo" },
        "asOf": { "$ref": "common.schema.json#/$defs/DateTime" },
        "projectionVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "ContainerShipmentContextV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shipmentId",
        "shipmentNumber",
        "linkId",
        "linkVersion",
        "currentLifecycleStatus",
        "relationshipVersion",
        "carrierCode",
        "vesselName",
        "voyageNumber",
        "originCountryCode",
        "originUnlocode",
        "destinationCountryCode",
        "salesCountryCode",
        "cargoOwnerReferenceId",
        "cargoOwnerName",
        "destinationUnlocode",
        "atdAt",
        "etaAt",
        "transportDocuments",
        "upstreamReferences"
      ],
      "properties": {
        "shipmentId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "shipmentNumber": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "linkId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "linkVersion": { "type": "integer", "minimum": 1 },
        "currentLifecycleStatus": {
          "$ref": "#/$defs/ShipmentLifecycleStatusV1"
        },
        "relationshipVersion": { "type": "integer", "minimum": 1 },
        "carrierCode": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64
        },
        "vesselName": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "voyageNumber": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "originCountryCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "originUnlocode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
        },
        "destinationCountryCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "salesCountryCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "cargoOwnerReferenceId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Uuid" },
            { "type": "null" }
          ]
        },
        "cargoOwnerName": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "destinationUnlocode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
        },
        "atdAt": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/DateTime" },
            { "type": "null" }
          ]
        },
        "etaAt": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/DateTime" },
            { "type": "null" }
          ]
        },
        "transportDocuments": {
          "type": "array",
          "items": { "$ref": "#/$defs/ShipmentTransportDocumentViewV1" }
        },
        "upstreamReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/ShipmentUpstreamReferenceViewV1" }
        }
      }
    },
    "TimelinePage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "pageInfo", "asOf", "projectionVersion"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "lifecycle-timeline.schema.json#/$defs/ContainerTimelineItem"
          }
        },
        "pageInfo": { "$ref": "#/$defs/PageInfo" },
        "asOf": { "$ref": "common.schema.json#/$defs/DateTime" },
        "projectionVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "CustomsFilingState": {
      "enum": ["not_filed", "filed", "accepted"]
    },
    "CustomsDecisionState": {
      "enum": ["pending", "held", "released"]
    },
    "CustomsClearanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "containerRecordId",
        "version",
        "jurisdictionCountryCode",
        "customsBrokerPartyId",
        "declarationNumber",
        "filingState",
        "decisionState",
        "activeHoldCodes",
        "evidenceRefs",
        "actorId",
        "reasonCode",
        "createdAt",
        "duplicate"
      ],
      "properties": {
        "caseId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "containerRecordId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "jurisdictionCountryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "customsBrokerPartyId": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/Uuid" },
            { "type": "null" }
          ]
        },
        "declarationNumber": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "filingState": { "$ref": "#/$defs/CustomsFilingState" },
        "decisionState": { "$ref": "#/$defs/CustomsDecisionState" },
        "activeHoldCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/StableCode" }
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasonCode": { "$ref": "common.schema.json#/$defs/StableCode" },
        "createdAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "duplicate": { "type": "boolean" }
      }
    },
    "ReplaceCustomsClearanceCaseCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion",
        "jurisdictionCountryCode",
        "customsBrokerPartyId",
        "declarationNumber",
        "filingState",
        "decisionState",
        "activeHoldCodes",
        "evidenceRefs",
        "reasonCode",
        "idempotencyKey"
      ],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "jurisdictionCountryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "customsBrokerPartyId": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/Uuid" },
            { "type": "null" }
          ]
        },
        "declarationNumber": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "filingState": { "$ref": "#/$defs/CustomsFilingState" },
        "decisionState": { "$ref": "#/$defs/CustomsDecisionState" },
        "activeHoldCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/StableCode" }
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "reasonCode": { "$ref": "common.schema.json#/$defs/StableCode" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "WarehouseDeliveryInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructionId",
        "containerRecordId",
        "version",
        "warehouseLocationId",
        "warehouseCode",
        "warehouseName",
        "unlocode",
        "timezone",
        "appointmentStartAt",
        "appointmentEndAt",
        "appointmentReference",
        "evidenceRefs",
        "actorId",
        "reasonCode",
        "createdAt",
        "duplicate"
      ],
      "properties": {
        "instructionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "containerRecordId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "warehouseLocationId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "warehouseCode": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64
        },
        "warehouseName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "unlocode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
        },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "appointmentStartAt": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/DateTime" },
            { "type": "null" }
          ]
        },
        "appointmentEndAt": {
