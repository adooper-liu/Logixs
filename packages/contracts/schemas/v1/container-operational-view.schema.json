{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logixs.internal/contracts/v1/container-operational-view.schema.json",
  "title": "ContainerOperationalViewV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "containerId", "containerNumber", "flow", "currentNode", "nodes", "tasks", "workOrders", "professionalFacts", "evidenceSummary", "syncSummary", "activeBlocks", "activeExceptions", "allowedActions", "projectionVersion", "sourceVersions", "asOf", "freshness"],
  "properties": {
    "tenantId": {"$ref": "common.schema.json#/$defs/Uuid"},
    "containerId": {"$ref": "common.schema.json#/$defs/Uuid"},
    "containerNumber": {"type": "string", "minLength": 1, "maxLength": 32},
    "flow": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["flowInstanceId", "state", "definitionVersion", "version"],
      "properties": {
        "flowInstanceId": {"$ref": "common.schema.json#/$defs/Uuid"},
        "state": {"$ref": "common.schema.json#/$defs/StableCode"},
        "definitionVersion": {"type": "integer", "minimum": 1},
        "version": {"type": "integer", "minimum": 0}
      }
    },
    "currentNode": {"oneOf": [{"$ref": "#/$defs/NodeSummary"}, {"type": "null"}]},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/NodeSummary"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/TaskSummary"}},
    "workOrders": {"type": "array", "items": {"$ref": "#/$defs/WorkOrderSummary"}},
    "professionalFacts": {"type": "array", "items": {"$ref": "#/$defs/ProfessionalFactSummary"}},
    "evidenceSummary": {"type": "object", "required": ["total", "effective", "pending", "disputed"], "properties": {"total": {"type": "integer", "minimum": 0}, "effective": {"type": "integer", "minimum": 0}, "pending": {"type": "integer", "minimum": 0}, "disputed": {"type": "integer", "minimum": 0}}},
    "syncSummary": {"type": "object", "required": ["operations"], "properties": {"operations": {"type": "array", "items": {"$ref": "#/$defs/SyncOperationSummary"}}}},
    "activeBlocks": {"type": "array", "items": {"type": "object"}},
    "activeExceptions": {"type": "array", "items": {"type": "object"}},
    "allowedActions": {"type": "array", "items": {"$ref": "#/$defs/AllowedAction"}},
    "projectionVersion": {"type": "integer", "minimum": 0},
    "sourceVersions": {"type": "array", "items": {"type": "object", "required": ["source", "version"], "properties": {"source": {"$ref": "common.schema.json#/$defs/StableCode"}, "version": {"type": "integer", "minimum": 0}}}},
    "asOf": {"$ref": "common.schema.json#/$defs/DateTime"},
    "freshness": {"$ref": "#/$defs/Freshness"}
  },
  "$defs": {
    "NodeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeInstanceId", "nodeCode", "sequence", "activationNo", "applicability", "state", "activeBlockCount", "taskProgress", "version"],
      "properties": {
        "nodeInstanceId": {"$ref": "common.schema.json#/$defs/Uuid"},
        "nodeCode": {"$ref": "common.schema.json#/$defs/LifecycleNodeCode"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 14},
        "activationNo": {"type": "integer", "minimum": 1},
        "applicability": {"enum": ["required", "optional", "not_applicable"]},
        "state": {"$ref": "common.schema.json#/$defs/StableCode"},
        "plannedAt": {"$ref": "common.schema.json#/$defs/DateTime"},
        "estimatedAt": {"$ref": "common.schema.json#/$defs/DateTime"},
        "actualAt": {"$ref": "common.schema.json#/$defs/DateTime"},
        "activeBlockCount": {"type": "integer", "minimum": 0},
        "taskProgress": {"type": "object", "required": ["required", "completed", "blocked"], "properties": {"required": {"type": "integer", "minimum": 0}, "completed": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0}}},
        "version": {"type": "integer", "minimum": 0}
      }
    },
    "TaskSummary": {
      "type": "object",
      "required": ["nodeTaskId", "nodeInstanceId", "state", "version"],
      "properties": {"nodeTaskId": {"$ref": "common.schema.json#/$defs/Uuid"}, "nodeInstanceId": {"$ref": "common.schema.json#/$defs/Uuid"}, "state": {"$ref": "common.schema.json#/$defs/NodeTaskState"}, "version": {"type": "integer", "minimum": 0}}
    },
    "WorkOrderSummary": {
      "type": "object",
      "required": ["workOrderId", "nodeTaskId", "state", "applicability", "version"],
      "properties": {"workOrderId": {"$ref": "common.schema.json#/$defs/Uuid"}, "nodeTaskId": {"$ref": "common.schema.json#/$defs/Uuid"}, "state": {"$ref": "common.schema.json#/$defs/WorkOrderState"}, "applicability": {"$ref": "common.schema.json#/$defs/WorkOrderApplicability"}, "version": {"type": "integer", "minimum": 0}}
    },
    "ProfessionalFactSummary": {
      "type": "object",
      "required": ["domainFactId", "factType", "occurredAt", "validity", "confidenceState", "evidenceRefs"],
      "properties": {"domainFactId": {"$ref": "common.schema.json#/$defs/Uuid"}, "factType": {"$ref": "common.schema.json#/$defs/StableCode"}, "occurredAt": {"$ref": "common.schema.json#/$defs/DateTime"}, "validity": {"$ref": "common.schema.json#/$defs/EvidenceValidity"}, "confidenceState": {"$ref": "common.schema.json#/$defs/ConfidenceState"}, "evidenceRefs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/Uuid"}}}
    },
    "SyncOperationSummary": {
      "type": "object",
      "required": ["clientOperationId", "receptionState", "businessDecisionState", "commitState", "traceId"],
      "properties": {"clientOperationId": {"$ref": "common.schema.json#/$defs/Uuid"}, "receptionState": {"$ref": "common.schema.json#/$defs/ReceptionState"}, "businessDecisionState": {"$ref": "common.schema.json#/$defs/BusinessDecisionState"}, "commitState": {"$ref": "common.schema.json#/$defs/CommitState"}, "traceId": {"type": "string", "minLength": 1}}
    },
    "AllowedAction": {
      "type": "object",
      "required": ["actionCode", "actionVersion", "executable", "confirmationPolicy", "reviewPolicy", "requiredEvidenceTypes", "expectedVersion"],
      "properties": {"actionCode": {"$ref": "common.schema.json#/$defs/StableCode"}, "actionVersion": {"type": "integer", "minimum": 1}, "executable": {"type": "boolean"}, "denialCategory": {"enum": ["authentication", "scope", "capability", "state", "precondition", "evidence", "lock", "review", "concurrency"]}, "confirmationPolicy": {"enum": ["none", "explicit", "reason_required"]}, "reviewPolicy": {"enum": ["none", "four_eyes", "designated_reviewer"]}, "requiredEvidenceTypes": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableCode"}}, "expectedVersion": {"type": "integer", "minimum": 0}}
    },
    "Freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "projectedAt"],
      "properties": {"state": {"enum": ["current", "catching_up", "stale", "rebuilding", "unavailable"]}, "projectedAt": {"$ref": "common.schema.json#/$defs/DateTime"}, "sourceHighWatermark": {"type": "string", "minLength": 1}, "lagSeconds": {"type": "integer", "minimum": 0}, "reasonCode": {"type": "string", "minLength": 1, "maxLength": 100}}
    }
  }
}
