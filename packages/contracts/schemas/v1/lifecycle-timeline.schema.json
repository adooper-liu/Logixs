{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logixs.internal/contracts/v1/lifecycle-timeline.schema.json",
  "title": "Lifecycle Timeline Contracts V1",
  "oneOf": [
    { "$ref": "#/$defs/ContainerTimelineItem" },
    { "$ref": "#/$defs/ContainerTimeProjection" },
    { "$ref": "#/$defs/NodeEventApplication" },
    { "$ref": "#/$defs/TimelineReplayRequest" },
    { "$ref": "#/$defs/LifecycleDateFactCommand" },
    { "$ref": "#/$defs/LifecycleDateFactInboxPayload" },
    { "$ref": "#/$defs/LifecycleDateFactResult" }
  ],
  "$defs": {
    "LifecycleDateFactCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "containerId",
        "nodeCode",
        "eventCode",
        "timeKind",
        "occurredAt",
        "rawValue",
        "sourceUtcOffset",
        "ingestionChannel",
        "captureSource",
        "sourceSystem",
        "authoritySystem",
        "verificationState",
        "confidenceState",
        "validity",
        "evidenceRefs",
        "idempotencyKey",
        "traceId"
      ],
      "properties": {
        "tenantId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "containerId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "nodeCode": { "$ref": "common.schema.json#/$defs/LifecycleNodeCode" },
        "eventCode": { "$ref": "common.schema.json#/$defs/CanonicalEventCode" },
        "timeKind": { "$ref": "common.schema.json#/$defs/TimeKind" },
        "occurredAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "rawValue": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceUtcOffset": {
          "type": "string",
          "pattern": "^(?:[+-](?:0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$"
        },
        "ingestionChannel": {
          "enum": ["api", "webhook", "file_import", "manual_ui"]
        },
        "captureSource": { "$ref": "common.schema.json#/$defs/CaptureSource" },
        "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authoritySystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "interfaceCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "verificationState": {
          "$ref": "common.schema.json#/$defs/VerificationState"
        },
        "confidenceState": {
          "$ref": "common.schema.json#/$defs/ConfidenceState"
        },
        "validity": { "$ref": "common.schema.json#/$defs/EvidenceValidity" },
        "authorityPolicyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "上游可携带声明引用用于审计，但不得授予权威；运行时只保存服务端唯一策略裁决返回的 policyId:version。"
        },
        "location": {
          "$ref": "canonical-event-envelope.schema.json#/properties/location"
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "actorId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "supersedesFactId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "traceId": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "timeKind": { "const": "actual" } },
            "required": ["timeKind"]
          },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "ingestionChannel": { "const": "manual_ui" } },
            "required": ["ingestionChannel"]
          },
          "then": {
            "required": ["actorId", "reasonCode", "expectedVersion"]
          }
        }
      ]
    },
    "LifecycleDateFactInboxPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command"],
      "properties": {
        "kind": { "const": "lifecycle_date_fact.record_requested.v1" },
        "command": { "$ref": "#/$defs/LifecycleDateFactCommand" }
      }
    },
    "LifecycleDateFactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "recordState",
        "applicationState",
        "projectionVersion"
      ],
      "properties": {
        "factId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "recordState": { "enum": ["recorded", "duplicate"] },
        "applicationState": {
          "enum": [
            "not_applicable",
            "review_required",
            "pending_application",
            "applied",
            "rejected"
          ]
        },
        "reasonCode": { "type": ["string", "null"], "maxLength": 100 },
        "canonicalEventId": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/Uuid" },
            { "type": "null" }
          ]
        },
        "projectionVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "ContainerTimelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventCode",
        "eventVersion",
        "containerId",
        "flowInstanceId",
        "nodeCode",
        "nodeInstanceId",
        "role",
        "timeKind",
        "occurredAt",
        "recordedAt",
        "validity",
        "confidenceState",
        "sourceSummary",
        "evidenceRefs",
        "domain",
        "domainFactId",
        "eventSequence",
        "projectionVersion"
      ],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "eventCode": { "$ref": "common.schema.json#/$defs/CanonicalEventCode" },
        "eventVersion": { "const": 1 },
        "containerId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "flowInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "nodeCode": { "$ref": "common.schema.json#/$defs/LifecycleNodeCode" },
        "nodeInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "role": { "$ref": "common.schema.json#/$defs/EventRole" },
        "timeKind": { "$ref": "common.schema.json#/$defs/TimeKind" },
        "occurredAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "recordedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "receivedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "validity": { "$ref": "common.schema.json#/$defs/EvidenceValidity" },
        "confidenceState": {
          "$ref": "common.schema.json#/$defs/ConfidenceState"
        },
        "sourceSummary": {
          "$ref": "canonical-event-envelope.schema.json#/properties/source"
        },
        "location": {
          "$ref": "canonical-event-envelope.schema.json#/properties/location"
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "relation": {
          "$ref": "canonical-event-envelope.schema.json#/properties/relation"
        },
        "domain": { "type": "string", "minLength": 1, "maxLength": 64 },
        "domainFactId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "eventSequence": { "type": "integer", "minimum": 1 },
        "projectionVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "NodeTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCode", "confidenceState"],
      "properties": {
        "nodeCode": { "$ref": "common.schema.json#/$defs/LifecycleNodeCode" },
        "segmentId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "plannedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "estimatedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "actualAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "confidenceState": {
          "$ref": "common.schema.json#/$defs/ConfidenceState"
        }
      }
    },
    "ActiveException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventCode", "nodeCode", "severity"],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "eventCode": { "$ref": "common.schema.json#/$defs/CanonicalEventCode" },
        "nodeCode": { "$ref": "common.schema.json#/$defs/LifecycleNodeCode" },
        "severity": { "$ref": "common.schema.json#/$defs/StableCode" }
      }
    },
    "Dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventIds", "reasonCode"],
      "properties": {
        "eventIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "ContainerTimeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerId",
        "flowInstanceId",
        "currentNodeCode",
        "currentContainerState",
        "nodeTimes",
        "activeExceptions",
        "disputes",
        "projectionVersion",
        "asOf"
      ],
      "properties": {
        "containerId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "flowInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "currentNodeCode": {
          "$ref": "common.schema.json#/$defs/LifecycleNodeCode"
        },
        "currentContainerState": {
          "$ref": "common.schema.json#/$defs/ContainerLifecycleState"
        },
        "nodeTimes": {
          "type": "array",
          "items": { "$ref": "#/$defs/NodeTime" }
        },
        "activeExceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActiveException" }
        },
        "disputes": { "type": "array", "items": { "$ref": "#/$defs/Dispute" } },
        "projectionVersion": { "type": "integer", "minimum": 0 },
        "asOf": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "NodeEventApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "targetNodeInstanceId",
        "state",
        "evaluatedAt",
        "guardResults"
      ],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "targetNodeInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "state": { "enum": ["pending_application", "applied", "rejected"] },
        "evaluatedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "guardResults": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/StableCode" }
        },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "TimelineReplayRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "flowInstanceId",
        "projectionName",
        "fromEventSequence",
        "expectedProjectionVersion",
        "reasonCode",
        "actorId",
        "traceId"
      ],
      "properties": {
        "tenantId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "flowInstanceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "projectionName": { "$ref": "common.schema.json#/$defs/StableCode" },
        "fromEventSequence": { "type": "integer", "minimum": 1 },
        "expectedProjectionVersion": { "type": "integer", "minimum": 0 },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "actorId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "traceId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
