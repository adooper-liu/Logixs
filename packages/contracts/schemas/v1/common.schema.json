{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logixs.internal/contracts/v1/common.schema.json",
  "title": "Logix Common Types V1",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "StableCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,99}$"
    },
    "BoundedContextCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "LifecycleNodeCode": {
      "type": "string",
      "enum": [
        "cargo_ready",
        "container_stuffing",
        "shipment_dispatch",
        "origin_departure",
        "ocean_transit",
        "transshipment",
        "customs_clearance",
        "destination_arrival",
        "rail_transfer",
        "container_pickup",
        "warehouse_delivery",
        "container_unloading",
        "container_unstuffing",
        "empty_return"
      ]
    },
    "CanonicalEventCode": {
      "type": "string",
      "enum": [
        "cargo_ready",
        "empty_picked_up",
        "stuffed",
        "loaded",
        "departed",
        "sailing",
        "gate_in",
        "transit_arrived",
        "transit_departed",
        "arrived",
        "berthed",
        "discharged",
        "available",
        "release",
        "hold",
        "hold_released",
        "customs_filed",
        "inspection",
        "container_customs_completed",
        "rail_handover",
        "gate_out",
        "delivered",
        "warehouse_arrival",
        "unloaded",
        "unstuffed",
        "returned_empty",
        "dumped",
        "rolled",
        "cancelled",
        "changed",
        "delay",
        "overdue"
      ]
    },
    "TimeKind": {
      "enum": ["planned", "estimated", "actual"]
    },
    "EventRole": {
      "enum": ["milestone", "evidence", "exception", "prerequisite"]
    },
    "NodeApplicability": {
      "enum": ["required", "optional_applicable", "optional_not_applicable"]
    },
    "FlowInstanceState": {
      "enum": ["draft", "active", "completed", "cancelled"]
    },
    "LifecycleNodeState": {
      "enum": [
        "pending",
        "active",
        "blocked",
        "completed",
        "skipped",
        "cancelled"
      ]
    },
    "ContainerLifecycleState": {
      "enum": [
        "not_shipped",
        "shipped",
        "in_transit",
        "at_port",
        "picked_up",
        "unloaded",
        "returned_empty",
        "cancelled"
      ]
    },
    "NodeTaskState": {
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "completed",
        "reopened",
        "cancelled"
      ]
    },
    "WorkOrderState": {
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "blocked",
        "completed",
        "failed",
        "reopened",
        "cancelled"
      ]
    },
    "WorkOrderApplicability": {
      "enum": ["required", "optional", "conditional_required", "not_applicable"]
    },
    "WorkOrderRequirement": {
      "enum": ["required", "optional", "conditional"]
    },
    "ExecutionMode": {
      "enum": ["human", "system", "external", "hybrid"]
    },
    "AssignmentPolicy": {
      "enum": ["named", "team", "pool", "automatic"]
    },
    "AssignmentState": {
      "enum": ["unassigned", "assigned", "pool", "automatic"]
    },
    "FactApplicationDecision": {
      "enum": ["applied", "rejected", "no_op"]
    },
    "CaptureSource": {
      "enum": [
        "external_evidence",
        "manual_backfill",
        "controlled_import",
        "internal_operation",
        "system_derived"
      ]
    },
    "AuthorityLevel": {
      "enum": ["authoritative", "corroborating", "operational", "contextual"]
    },
    "VerificationState": {
      "enum": ["pending", "verified", "rejected", "revoked"]
    },
    "ConfidenceState": {
      "enum": ["confirmed", "provisional", "disputed", "unknown"]
    },
    "EvidenceValidity": {
      "enum": ["effective", "superseded", "corrected", "revoked"]
    },
    "EvidenceRelationType": {
      "enum": ["supports", "contradicts", "corrects", "revokes", "supersedes"]
    },
    "EventRelationType": {
      "enum": ["corrects", "revokes", "supersedes_estimate"]
    },
    "ReceptionState": {
      "enum": ["pending", "received", "duplicate", "boundary_rejected"]
    },
    "BusinessDecisionState": {
      "enum": ["pending", "accepted", "rejected"]
    },
    "CommitState": {
      "enum": ["pending", "committed", "commit_failed"]
    },
    "InboxState": {
      "enum": [
        "received",
        "processing",
        "processed",
        "retry_wait",
        "dead_letter"
      ]
    },
    "OutboxState": {
      "enum": [
        "pending",
        "publishing",
        "published",
        "retry_wait",
        "dead_letter"
      ]
    },
    "CompensationState": {
      "enum": [
        "not_required",
        "pending",
        "in_progress",
        "compensated",
        "failed",
        "manual_review"
      ]
    },
    "ActorType": {
      "enum": ["user", "service", "integration", "scheduled_job"]
    },
    "RiskLevel": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "ConfirmationPolicy": {
      "enum": ["none", "explicit", "reason_required"]
    },
    "ReviewPolicy": {
      "enum": ["none", "four_eyes", "designated_reviewer"]
    },
    "DenialCategory": {
      "enum": [
        "authentication",
        "scope",
        "capability",
        "state",
        "precondition",
        "evidence",
        "lock",
        "review",
        "concurrency"
      ]
    },
    "EntityType": {
      "enum": [
        "container",
        "flow_instance",
        "node_instance",
        "node_task",
        "work_order",
        "domain_fact",
        "evidence",
        "canonical_event",
        "client_operation",
        "receipt",
        "exception",
        "audit_entry"
      ]
    },
    "ErrorCategory": {
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "not_found",
        "conflict",
        "precondition",
        "rate_limit",
        "dependency",
        "internal"
      ]
    },
    "EntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "entityType", "entityId", "ownerModule"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/Uuid" },
        "entityType": { "$ref": "#/$defs/EntityType" },
        "entityId": { "$ref": "#/$defs/Uuid" },
        "ownerModule": { "$ref": "#/$defs/BoundedContextCode" }
      }
    }
  }
}
