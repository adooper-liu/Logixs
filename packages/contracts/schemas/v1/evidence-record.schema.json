{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logixs.internal/contracts/v1/evidence-record.schema.json",
  "title": "EvidenceRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "tenantId",
    "evidenceType",
    "subjectType",
    "subjectId",
    "source",
    "authorityLevel",
    "contentRef",
    "contentHash",
    "receivedAt",
    "recordedAt",
    "verificationState",
    "confidenceState",
    "validity",
    "sensitivityClass",
    "retentionPolicyRef"
  ],
  "properties": {
    "evidenceId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "tenantId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "evidenceType": {
      "enum": [
        "document",
        "api_response",
        "receipt",
        "message",
        "photo",
        "scan",
        "device_record",
        "system_record",
        "attestation"
      ]
    },
    "subjectType": { "$ref": "common.schema.json#/$defs/EntityType" },
    "subjectId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "originatorSystem",
        "authoritySystem",
        "ingestionChannel",
        "captureSource"
      ],
      "properties": {
        "sourceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "sourceType": {
          "enum": ["organization", "authority", "system", "person", "device"]
        },
        "originatorSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "authoritySystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "providerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "interfaceCode": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceEventId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mappingVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ingestionChannel": {
          "enum": [
            "api",
            "webhook",
            "file_import",
            "manual_ui",
            "system_internal"
          ]
        },
        "captureSource": { "$ref": "common.schema.json#/$defs/CaptureSource" },
        "actorId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "receivedAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "authorityLevel": { "$ref": "common.schema.json#/$defs/AuthorityLevel" },
    "contentRef": { "type": "string", "minLength": 1, "maxLength": 500 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "originalFileName": { "type": "string", "minLength": 1, "maxLength": 255 },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "maxLength": 127
    },
    "occurredAt": { "$ref": "common.schema.json#/$defs/DateTime" },
    "issuedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
    "receivedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
    "recordedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
    "verificationState": {
      "$ref": "common.schema.json#/$defs/VerificationState"
    },
    "confidenceState": { "$ref": "common.schema.json#/$defs/ConfidenceState" },
    "validity": { "$ref": "common.schema.json#/$defs/EvidenceValidity" },
    "relation": { "$ref": "#/$defs/EvidenceRelation" },
    "sensitivityClass": { "$ref": "common.schema.json#/$defs/StableCode" },
    "retentionPolicyRef": { "type": "string", "minLength": 1, "maxLength": 100 }
  },
  "$defs": {
    "EvidenceSource": { "$ref": "#/properties/source" },
    "EvidenceRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationType",
        "relatedEvidenceId",
        "reasonCode",
        "createdAt"
      ],
      "properties": {
        "relationType": {
          "$ref": "common.schema.json#/$defs/EvidenceRelationType"
        },
        "relatedEvidenceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "authorizedBy": { "$ref": "common.schema.json#/$defs/Uuid" },
        "createdAt": { "$ref": "common.schema.json#/$defs/DateTime" }
      }
    },
    "SourceAuthorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyVersion",
        "effectiveFrom",
        "subjectType",
        "allowedAuthoritySystems",
        "allowedSourceTypes",
        "minimumAuthorityLevel",
        "requiredEvidenceTypes",
        "verificationRequirements",
        "conflictAction",
        "manualCorrectionPolicyRef",
        "sealingPolicyRef"
      ],
      "properties": {
        "policyId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "effectiveFrom": { "$ref": "common.schema.json#/$defs/DateTime" },
        "effectiveTo": { "$ref": "common.schema.json#/$defs/DateTime" },
        "tenantScope": { "$ref": "common.schema.json#/$defs/Uuid" },
        "factType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "eventCode": { "$ref": "common.schema.json#/$defs/CanonicalEventCode" },
        "fieldCode": { "$ref": "common.schema.json#/$defs/StableCode" },
        "subjectType": { "$ref": "common.schema.json#/$defs/EntityType" },
        "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 32 },
        "direction": { "$ref": "common.schema.json#/$defs/StableCode" },
        "locationRole": { "$ref": "common.schema.json#/$defs/StableCode" },
        "transportMode": { "$ref": "common.schema.json#/$defs/StableCode" },
        "timeKind": { "$ref": "common.schema.json#/$defs/TimeKind" },
        "allowedAuthoritySystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "allowedSourceTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["organization", "authority", "system", "person", "device"]
          }
        },
        "minimumAuthorityLevel": {
          "$ref": "common.schema.json#/$defs/AuthorityLevel"
        },
        "requiredEvidenceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/StableCode" }
        },
        "verificationRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/StableCode" }
        },
        "corroborationRule": { "$ref": "common.schema.json#/$defs/StableCode" },
        "conflictAction": { "enum": ["accept", "reject", "review"] },
        "manualCorrectionPolicyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sealingPolicyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "anyOf": [
        { "required": ["factType"] },
        { "required": ["eventCode"] },
        { "required": ["fieldCode"] }
      ]
    },
    "EvidenceVerificationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationDecisionId",
        "evidenceId",
        "verificationSequence",
        "decision",
        "checks",
        "policyId",
        "policyVersion",
        "decidedAt",
        "actorOrServiceId",
        "reasonCode"
      ],
      "properties": {
        "verificationDecisionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "evidenceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "verificationSequence": { "type": "integer", "minimum": 1 },
        "decision": { "enum": ["verified", "rejected", "revoked"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/StableCode" }
        },
        "policyId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "decidedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "actorOrServiceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "previousDecisionId": { "$ref": "common.schema.json#/$defs/Uuid" }
      }
    },
    "ManualAuthorityLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockId",
        "tenantId",
        "scopeType",
        "scopeId",
        "effect",
        "reasonCode",
        "reason",
        "evidenceRefs",
        "createdBy",
        "createdAt",
        "expectedVersion"
      ],
      "properties": {
        "lockId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "tenantId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "scopeType": {
          "enum": ["evidence", "fact", "field", "event", "projection"]
        },
        "scopeId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "fieldCode": { "$ref": "common.schema.json#/$defs/StableCode" },
        "effect": { "enum": ["review_before_replace", "freeze_projection"] },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uuid" }
        },
        "createdBy": { "$ref": "common.schema.json#/$defs/Uuid" },
        "createdAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "expiresAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "releasedBy": { "$ref": "common.schema.json#/$defs/Uuid" },
        "releasedAt": { "$ref": "common.schema.json#/$defs/DateTime" },
        "releaseReason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": { "captureSource": { "const": "manual_backfill" } },
            "required": ["captureSource"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": { "source": { "required": ["actorId"] } }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": { "captureSource": { "const": "external_evidence" } },
            "required": ["captureSource"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "source": {
            "required": ["provider", "interfaceCode", "mappingVersion"]
          }
        }
      }
    }
  ]
}
