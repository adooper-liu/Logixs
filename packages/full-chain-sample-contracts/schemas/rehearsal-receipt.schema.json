{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rehearsal-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptVersion",
    "runId",
    "packageId",
    "tenantRef",
    "state",
    "counts",
    "gapCounts",
    "reconciliationDigest",
    "createdAt"
  ],
  "properties": {
    "receiptVersion": { "const": "full-chain-rehearsal-receipt.v1" },
    "runId": { "type": "string", "format": "uuid" },
    "packageId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "tenantRef": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "state": { "const": "staged" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "gapCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "reconciliationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
