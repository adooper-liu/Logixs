{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "booking-commitment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bookingNo", "masterBillNo", "houseBillRefs", "containerRefs"],
  "properties": {
    "bookingNo": { "type": "string", "minLength": 1 },
    "masterBillNo": { "type": "string", "minLength": 1 },
    "houseBillRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "containerRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
