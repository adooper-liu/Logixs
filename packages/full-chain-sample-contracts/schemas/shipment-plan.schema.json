{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipment-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["planNo", "containerRefs", "bookingNo"],
  "properties": {
    "planNo": { "type": "string", "minLength": 1 },
    "containerRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "bookingNo": { "type": "string", "minLength": 1 }
  }
}
